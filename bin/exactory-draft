#!/usr/bin/env python3
"""exactory-draft: draft workspace setup and Zenodo deposit.

Two commands:
  init     - create the draft workspace layout and .exactory/draft.json
  deposit  - upload the built PDF (and optional sources) to Zenodo

The deposit runs in a draft workspace, from its root: it reads the paper's
title from .exactory/draft.json there.

Deposits go to the Zenodo sandbox and stay in the draft state by default.
--production targets zenodo.org, and --publish makes the record public. A
production deposit first runs the offline citation check (exactory-check gate);
a failing check prints one Citation report line and the deposit continues. A
workspace whose publication and round gates are ready records the deposit as a
managed receipt; a workspace that refuses the receipt deposits directly and
prints one Managed record skipped line; a workspace with no store deposits
directly with no line. A production publish also needs the --confirm-publish
flag, because a published DOI is permanent. Tokens come from
ZENODO_SANDBOX_TOKEN / ZENODO_TOKEN. The API shape follows
https://developers.zenodo.org. Python standard library only.
"""

from __future__ import annotations

import argparse
import html
import json
import os
import sys
import time
import urllib.error
import urllib.request
import uuid
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parents[1]))
from research_harness.errors import ResearchError
from research_harness.integration import command_identity, current_store, initialization_payload, initialize_workspace, record_direct_deposit
from research_harness.storage import Store
from research_harness.workspace import find_workspace, json_projection
from research_harness.citation_report import report_citation_gate
from research_harness.zenodo import (PAPER_UPLOAD_NAME, RDM_JSON_MEDIA_TYPE, build_draft_document_url,
                                     build_previewed_document, continue_deposit,
                                     deposit as deposit_bundle, validate_deposit)
from research_harness.cli import add_identity, note_managed_record_skipped, select_managed_path

_PRODUCTION_API_URL = "https://zenodo.org/api"
_SANDBOX_API_URL = "https://sandbox.zenodo.org/api"
_TIMEOUT_SECONDS = 180

# The release version has one definition: the plugin manifest. Deriving the
# User-Agent from it at boot keeps the two from drifting apart.
_PLUGIN_VERSION = json.loads(
    (Path(__file__).resolve().parent.parent / ".claude-plugin" / "plugin.json")
    .read_text(encoding="utf-8")
)["version"]
_USER_AGENT = f"exactory-draft/{_PLUGIN_VERSION}"

_WORKSPACE_DIR_NAMES = (".exactory", "draft", "evidence", "research", "reviews", "learnings")
_DRAFT_STATE_PATH = Path(".exactory/draft.json")
_DEPOSIT_STATE_PATH = Path(".exactory/deposit.json")
_AUTHORSHIP_STATE_PATH = Path(".exactory/authorship.json")
_DRAFT_DIR_PATH = Path("draft")

_LITERATURE_HEADER = (
    "# Literature survey log\n"
    "Append-only. Each search pass adds one block with: timestamp and context,"
    " Queries, Found, Verdict, Impact.\n"
)

# Two disclosures, because the two claims rest on different evidence. The
# first names exactory.ai as the writer, and only this workspace's own record
# that an agent wrote the paper selects it. The second states what this
# command itself did, which holds for every deposit.
_WRITTEN_BY_EXACTORY_DISCLOSURE_TEMPLATE = (
    "This preprint was written by exactory.ai (https://www.exactory.ai), an AI"
    " research system. The human author, {author}, reviewed the full content"
    " and is responsible for it."
)
_DEPOSITED_THROUGH_EXACTORY_DISCLOSURE_TEMPLATE = (
    "This preprint was prepared with AI assistance and deposited through"
    " exactory.ai (https://www.exactory.ai). The human author, {author},"
    " reviewed the full content and is responsible for it."
)

# One keyword, sent only with the disclosure that names exactory.ai as the
# writer, because it rests on the same evidence. The keyword answers "did
# exactory write this paper?", and a deposit this command only carried is not
# an answer to that question, so it sends no keyword.
_WRITTEN_BY_EXACTORY_KEYWORD = "Written by exactory.ai"

# The paper uploads under the fixed name research_harness.zenodo owns, because
# every step that names the paper to Zenodo must name the same file. The
# sources archive gets the supplementary stem because Zenodo lists a record's
# files by name: 'supplementary' sorts after 'paper', keeping the paper on top.
_SOURCES_UPLOAD_STEM = "supplementary-sources"

_CHECK_COMMAND_PATH = Path(__file__).with_name("exactory-check")

# What an uncertain outcome earns the user: an unreachable API and a 5xx both
# leave the request unsettled. Every request of this command can be sent again,
# except the publish of a direct deposit: a managed deposit resumes its saved
# intent, which settles each claimed step before it writes again, while a direct
# deposit has no intent, so a second run of it publishes a second permanent
# record. The advice names that record itself, because stderr carries it to a
# caller that reads none of the lines on stdout.
_RETRY_ADVICE_MSG = "Then run the command again."
_UNCERTAIN_DIRECT_PUBLISH_ADVICE_TEMPLATE = (
    "Deposition {deposition_id} may be published already. Open {draft_url} and"
    " read its state. Do not run this command again: a second run publishes a"
    " second permanent record."
)


def _exit_with_error(message: str, code: int = 1) -> None:
    print(message, file=sys.stderr)
    sys.exit(code)


def _run_init(args: argparse.Namespace) -> None:
    workspace_dir = Path(args.dir)
    state_path = workspace_dir / _DRAFT_STATE_PATH
    database = workspace_dir / ".exactory/research.sqlite3"
    if state_path.exists() and (not args.request_id or not database.exists()):
        _exit_with_error(f"{state_path} already exists."
                         " This directory is already a draft workspace.")
    state = {"version": 1, "title": args.title, "corpus": args.corpus,
             "category": args.category,
             "created": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime())}
    try:
        store = Store(workspace_dir, create=not database.exists())
        identity = command_identity(store, args)
        payload = initialization_payload(store, "draft", state, identity["request_id"])
        initialize_workspace(store, payload, **identity)
    except ResearchError as error:
        _exit_with_error(json.dumps({"error": error.as_dict()}))
    for dir_name in _WORKSPACE_DIR_NAMES:
        (workspace_dir / dir_name).mkdir(parents=True, exist_ok=True)
    literature_path = workspace_dir / "research" / "literature.md"
    if not literature_path.exists():
        literature_path.write_text(_LITERATURE_HEADER, encoding="utf-8")
    print(f"Created the draft workspace in {workspace_dir.resolve()}.")


# ----------------------------------------------------------- Zenodo deposit


def _open_url(request: urllib.request.Request) -> dict:
    """Send one Zenodo API request and return the parsed JSON body. Tests
    replace this function; nothing else touches the network."""
    with urllib.request.urlopen(request, timeout=_TIMEOUT_SECONDS) as response:
        body = response.read().decode("utf-8", "replace")
        return json.loads(body) if body else {}


def _call_zenodo(method: str, url: str, token: str,
                 json_body: dict | list | None = None,
                 file_bytes: bytes | None = None,
                 accept: str | None = None,
                 uncertain_outcome_advice_msg: str = _RETRY_ADVICE_MSG) -> dict:
    """Send one request to the Zenodo API and return its JSON body. Exits with
    Zenodo's own error message on failure, and never echoes the token. The
    caller names the advice an uncertain outcome earns, because only the caller
    knows whether its request can be sent again."""
    headers = {"Authorization": f"Bearer {token}", "User-Agent": _USER_AGENT}
    if accept is not None:
        headers["Accept"] = accept
    data = None
    if json_body is not None:
        data = json.dumps(json_body).encode()
        headers["Content-Type"] = "application/json"
    elif file_bytes is not None:
        data = file_bytes
        headers["Content-Type"] = "application/octet-stream"
    try:
        return _open_url(urllib.request.Request(url, method=method, data=data, headers=headers))
    except urllib.error.HTTPError as error:
        detail = error.read().decode("utf-8", "replace")[:2000]
        message = f"The Zenodo API returned HTTP {error.code}.\n{detail}"
        # A 5xx leaves this request as unsettled as a lost connection does: the
        # server states no outcome for it. A 4xx is the server's own decision,
        # which the same request cannot change.
        if error.code >= 500:
            message += f"\nThe server states no outcome for this request. {uncertain_outcome_advice_msg}"
        _exit_with_error(message)
    except OSError as error:
        _exit_with_error(f"The client cannot reach the Zenodo API. Cause: {error}."
                         f" Make sure that the network is available. {uncertain_outcome_advice_msg}")
    raise AssertionError("unreachable")


def _read_zenodo_token(production: bool) -> str:
    env_name = "ZENODO_TOKEN" if production else "ZENODO_SANDBOX_TOKEN"
    token = os.environ.get(env_name, "").strip()
    if token == "":
        _exit_with_error(f"{env_name} is not set. Create a personal access token in the"
                         " Zenodo account settings. Then set the variable.", 2)
    return token


def _load_draft_state() -> dict:
    """The draft marker, checked here because this read is its only edge.

    The deposit names the paper from this file, so the title is read where the
    file is, next to the file-level refusals, and no caller indexes it blind."""
    try:
        state = json.loads(_DRAFT_STATE_PATH.read_text(encoding="utf-8"))
    except FileNotFoundError:
        _exit_with_error(f"{_DRAFT_STATE_PATH} does not exist here."
                         " Run exactory-draft init first.", 2)
    except json.JSONDecodeError as error:
        _exit_with_error(f"{_DRAFT_STATE_PATH} is not valid JSON. Cause: {error}")
    # Any JSON value parses, and only an object can name a title.
    if not isinstance(state, dict) or "title" not in state:
        _exit_with_error(f"{_DRAFT_STATE_PATH} names no title."
                         " Write the paper's working title into it as \"title\".", 2)
    return state


def _find_newest_pdf() -> Path:
    pdf_paths = sorted(_DRAFT_DIR_PATH.rglob("*.pdf"),
                       key=lambda path: path.stat().st_mtime)
    if not pdf_paths:
        _exit_with_error("There is no PDF under draft/. Build the paper first, or pass --pdf.", 2)
    return pdf_paths[-1]


def _read_abstract_text(path: Path) -> str:
    """The abstract the record's description opens with, as the user wrote it.

    The direct path takes the abstract from any file the user names, so this
    reader owns the UTF-8 rule the pinned publication bundle used to own. It
    reads bytes and decodes them, because the publication bundle pins the
    file's own bytes: a text read translates CRLF to LF, which changes the
    description, and with it the deposit intent's fingerprint, so an
    interrupted deposit no longer resumes and creates a second record."""
    if not path.exists():
        _exit_with_error(f"The file {path} does not exist."
                         " Write the paper's abstract into it as plain text.", 2)
    try:
        abstract_text = path.read_bytes().decode("utf-8").strip()
    except (OSError, UnicodeDecodeError) as error:
        _exit_with_error(f"The client cannot read the abstract file {path} as UTF-8 text."
                         f" Cause: {error}."
                         " Write the paper's abstract into it as plain text.", 2)
    if abstract_text == "":
        _exit_with_error(f"The abstract file {path} is empty."
                         " Write the paper's abstract into it as plain text.", 2)
    return abstract_text


def _read_upload_bytes(path: Path) -> bytes:
    """The bytes of a file the user named for upload. The direct path uploads
    from disk, so an unreadable path stops the command instead of the runtime."""
    try:
        return path.read_bytes()
    except OSError as error:
        _exit_with_error(f"The client cannot read the file {path}. Cause: {error}.", 2)
    raise AssertionError("unreachable")


def _has_exactory_authorship_evidence(pdf_path: Path) -> bool:
    """Answer whether this workspace records that an agent wrote the paper
    being deposited: the PDF comes from the draft tree, and
    .exactory/authorship.json reads "written_by_exactory": true. The
    record_paper_authorship hook writes that file when an agent writes a LaTeX
    source under draft/, so the record comes from the act of writing itself.
    The decision log cannot serve as that record, because it holds what an
    agent chose to log rather than what an agent wrote. The value decides, not
    the file's presence, so a person who sets it to false turns the claim off.
    Every doubtful input answers False, so the disclosure that names
    exactory.ai as the writer stays off a paper this workspace has no record
    of writing."""
    if not pdf_path.resolve().is_relative_to(_DRAFT_DIR_PATH.resolve()):
        return False
    try:
        state = json.loads(_AUTHORSHIP_STATE_PATH.read_text(encoding="utf-8"))
    except (OSError, ValueError):
        return False
    return isinstance(state, dict) and state.get("written_by_exactory") is True


def _build_deposit_metadata(title: str, creators: list[str], abstract_text: str,
                            has_exactory_authorship_evidence: bool) -> dict:
    # Zenodo renders the description as HTML. The abstract paragraphs come
    # first, the disclosure closes the description as its own paragraph.
    paragraph_texts = [" ".join(block.split()) for block in abstract_text.split("\n\n")]
    paragraph_texts = [text for text in paragraph_texts if text != ""]
    disclosure_template = (_WRITTEN_BY_EXACTORY_DISCLOSURE_TEMPLATE
                           if has_exactory_authorship_evidence
                           else _DEPOSITED_THROUGH_EXACTORY_DISCLOSURE_TEMPLATE)
    paragraph_texts.append(disclosure_template.format(author=creators[0]))
    metadata = {
        "upload_type": "publication",
        "publication_type": "preprint",
        "title": title,
        "creators": [{"name": creator_name} for creator_name in creators],
        "description": "".join(f"<p>{html.escape(text)}</p>" for text in paragraph_texts),
    }
    if has_exactory_authorship_evidence:
        metadata["keywords"] = [_WRITTEN_BY_EXACTORY_KEYWORD]
    return metadata


def _name_sources_upload(sources_path: Path) -> str:
    for tar_suffix in (".tar.gz", ".tar.bz2", ".tar.xz"):
        if sources_path.name.endswith(tar_suffix):
            return _SOURCES_UPLOAD_STEM + tar_suffix
    return _SOURCES_UPLOAD_STEM + sources_path.suffix


def _run_deposit(args: argparse.Namespace) -> None:
    state = _load_draft_state()
    pdf_path = Path(args.pdf) if args.pdf else _find_newest_pdf()
    if not pdf_path.exists():
        _exit_with_error(f"The file {pdf_path} does not exist.", 2)
    sources_path = Path(args.sources) if args.sources else None
    if sources_path is not None and not sources_path.exists():
        _exit_with_error(f"The file {sources_path} does not exist.", 2)
    abstract_path = Path(args.abstract_file)
    abstract_text = _read_abstract_text(abstract_path)
    has_exactory_authorship_evidence = _has_exactory_authorship_evidence(pdf_path)
    token = _read_zenodo_token(args.production)
    if args.publish and args.production and not args.confirm_publish:
        _exit_with_error("A production publish is permanent. Get the user's approval"
                         " first. Then run the command again with --confirm-publish.")
    if args.production:
        # The offline citation check runs before the first remote write and
        # prints its report when it fails; the deposit continues either way,
        # because the user asked for it.
        report_citation_gate(Path.cwd(), _CHECK_COMMAND_PATH)

    base_url = _PRODUCTION_API_URL if args.production else _SANDBOX_API_URL
    environment = "production" if args.production else "sandbox"
    metadata = _build_deposit_metadata(state["title"], args.creator, abstract_text,
                                       has_exactory_authorship_evidence)

    # A study whose publication and round gates are ready records the receipt;
    # otherwise the record is created directly, and the user reads why on stderr.
    # The direct path keeps the store this call opened, so the command opens the
    # workspace once and notes a refusal once.
    store, deposit_report, store_open_error = select_managed_path(lambda workspace_store: validate_deposit(
        workspace_store, pdf_path, abstract_path, sources_path,
        new_version=args.new_version, environment=environment))
    if deposit_report is not None:
        _deposit_managed(store, deposit_report, args, base_url, environment, metadata, sources_path, token)
    else:
        _deposit_directly(store, store_open_error, args, base_url, environment, metadata,
                          pdf_path, sources_path, token)


def _deposit_managed(store, report: dict, args: argparse.Namespace, base_url: str, environment: str,
                     metadata: dict, sources_path: Path | None, token: str) -> None:
    bundle = report["bundle"]
    uploads = [{"name": PAPER_UPLOAD_NAME, "artifact": bundle["files"]["pdf"]["artifact"]}]
    if sources_path is not None:
        uploads.append({"name": _name_sources_upload(sources_path), "artifact": bundle["files"]["sources"]["artifact"]})
    binding = {"bundle_digest": bundle["digest"], "prepared_revision": bundle["prepared_revision"],
               "base_url": base_url, "environment": environment, "new_version": args.new_version,
               "publish": args.publish, "metadata": metadata, "uploads": uploads,
               "prior": store.snapshot()["records"].get("workspace", {}).get("deposit") if args.new_version else None}
    identity = command_identity(store, args)
    # CAS validates the snapshot that supplied the exact upload bytes.
    if args.expected_revision is None:
        identity["expected_revision"] = report["revision"]
    receipt = deposit_bundle(store, binding, lambda method, url, **kwargs: _call_zenodo(method, url, token, **kwargs), **identity)
    print(json.dumps(receipt, indent=2))


def _deposit_directly(store, store_open_error, args: argparse.Namespace, base_url: str, environment: str,
                      metadata: dict, pdf_path: Path, sources_path: Path | None, token: str) -> None:
    # Every local input is read before the first remote write, like the rest of
    # this command, so an unreadable path leaves no draft record on Zenodo. The
    # bytes were already held in full for the upload, so peak memory is the same.
    pdf_bytes = _read_upload_bytes(pdf_path)
    sources_bytes = _read_upload_bytes(sources_path) if sources_path is not None else None
    if args.new_version:
        deposition = _open_new_version_draft(base_url, environment, token)
    else:
        deposition = _call_zenodo("POST", f"{base_url}/deposit/depositions", token, json_body={})
    # The record exists from here on, and a publish cannot be made idempotent:
    # a second run creates and publishes a second permanent record. The user
    # reads the id and the draft link first, so a lost response leaves a record
    # to open instead of a deposit to repeat.
    draft_url = deposition.get("links", {}).get("html", "")
    print(f"Deposition {deposition['id']} is open on Zenodo: {draft_url}")
    bucket_url = deposition["links"]["bucket"]
    _call_zenodo("PUT", f"{bucket_url}/{PAPER_UPLOAD_NAME}", token, file_bytes=pdf_bytes)
    if sources_path is not None:
        _call_zenodo("PUT", f"{bucket_url}/{_name_sources_upload(sources_path)}", token,
                     file_bytes=sources_bytes)
    _call_zenodo("PUT", f"{base_url}/deposit/depositions/{deposition['id']}", token,
                 json_body={"metadata": metadata})
    _mark_paper_as_preview(base_url, deposition["id"], token)
    state = {"environment": environment, "deposition_id": deposition["id"],
             "draft_url": draft_url}
    if args.publish:
        # Per https://developers.zenodo.org, doi is present only on published
        # depositions; conceptdoi names the paper across all its versions.
        publish_response = _call_zenodo(
            "POST", f"{base_url}/deposit/depositions/{deposition['id']}/actions/publish", token,
            uncertain_outcome_advice_msg=_UNCERTAIN_DIRECT_PUBLISH_ADVICE_TEMPLATE.format(
                deposition_id=deposition["id"], draft_url=draft_url))
        state["doi"] = publish_response.get("doi", "")
        state["concept_doi"] = publish_response.get("conceptdoi", "")
        state["record_url"] = publish_response.get("links", {}).get("record_html", "")
        print(f"The record is published: {state['record_url']}")
    else:
        print(f"The draft deposit is created. Review it at: {state['draft_url']}")
    # The user reads the record before the local record is kept, so a store that
    # refuses the write still leaves the DOI on the screen.
    print(json.dumps(state, indent=2))
    _save_deposit_state(store, store_open_error, state)


def _mark_paper_as_preview(base_url: str, record_id: int, token: str) -> None:
    """Make the paper the record's previewed file. research_harness.zenodo owns
    the draft-document contract this shares with the managed deposit."""
    draft_url = build_draft_document_url(base_url, record_id)
    document = _call_zenodo("GET", draft_url, token, accept=RDM_JSON_MEDIA_TYPE)
    _call_zenodo("PUT", draft_url, token, json_body=build_previewed_document(document))


def _open_new_version_draft(base_url: str, environment: str, token: str) -> dict:
    try:
        prior = json.loads(_DEPOSIT_STATE_PATH.read_text(encoding="utf-8"))
    except FileNotFoundError:
        _exit_with_error(f"{_DEPOSIT_STATE_PATH} does not exist here."
                         " Run a plain deposit first; --new-version revises it.")
    except json.JSONDecodeError as error:
        _exit_with_error(f"{_DEPOSIT_STATE_PATH} is not valid JSON. Cause: {error}")
    if prior.get("environment") != environment:
        _exit_with_error(
            f"The stored deposit is on {prior.get('environment')}, not"
            f" {environment}. Run --new-version against the same environment.")
    deposition_id = prior.get("deposition_id")
    if deposition_id is None:
        _exit_with_error(f"{_DEPOSIT_STATE_PATH} names no deposition_id."
                         " Run a plain deposit first; --new-version revises it.")
    created = _call_zenodo(
        "POST",
        f"{base_url}/deposit/depositions/{deposition_id}/actions/newversion",
        token,
    )
    draft_url = created.get("links", {}).get("latest_draft", "")
    if draft_url == "":
        _exit_with_error("Zenodo returned no new-version draft link.")
    return _call_zenodo("GET", draft_url, token)


def _save_deposit_state(store, store_open_error, state: dict) -> None:
    """Keep the local record of a direct deposit.

    A workspace with a usable store records it there, and the projection export
    writes .exactory/deposit.json from that record. A workspace with no store
    has no projection export, so the file itself is the record and the command
    says nothing. The other two cases hold a store that did not take the
    record: it refused the write, or it never opened. Both leave a store that
    can serve a later projection export, which rewrites the file from a record
    the store does not hold, so both write the file, say that it is the only
    local copy, and exit nonzero instead of reporting a kept record.

    Those two cases write the file with the same projection primitive the
    export uses, because the file they write is the only local copy of a
    published DOI, and the primitive is what makes the replacement atomic and
    keeps it off a symlink. The command runs from the workspace root, which is
    why cwd is the root the projection is written under."""
    if store is None and store_open_error is None:
        json_projection(Path.cwd(), str(_DEPOSIT_STATE_PATH), state)
        return
    if store is None:
        _stop_with_only_the_local_deposit_copy(Path.cwd(), state)
        return
    try:
        record_direct_deposit(store, state, expected_revision=store.revision,
                              request_id="direct-deposit-" + uuid.uuid4().hex)
    except ResearchError as error:
        note_managed_record_skipped(error)
        _stop_with_only_the_local_deposit_copy(store.root, state)


def _stop_with_only_the_local_deposit_copy(root: Path, state: dict) -> None:
    """Write the deposit file, report it as the only local copy, and exit
    nonzero. The store holds no record of this deposit, so a later projection
    export replaces the file this writes. The message names that file, because
    stderr carries it to a caller that reads none of the lines on stdout."""
    json_projection(root, str(_DEPOSIT_STATE_PATH), state)
    _exit_with_error("The workspace store did not record this deposit. The record is on Zenodo."
                     f" {_DEPOSIT_STATE_PATH} holds the only local copy of it, and a projection"
                     " export can replace that file. Copy the state out of that file before the"
                     " next projection export.")


def _run_reconcile(args: argparse.Namespace) -> None:
    store = current_store(find_workspace())
    from research_harness.remote import get_intent
    intent = get_intent(store, args.intent_id)
    if intent["kind"] != "deposit":
        raise ResearchError("remote_intent_mismatch", "Use a deposit intent for Zenodo reconciliation")
    token = _read_zenodo_token(intent["binding"]["environment"] == "production")
    receipt = continue_deposit(store, args.intent_id,
        lambda method, url, **kwargs: _call_zenodo(method, url, token, **kwargs), reconcile=True)
    print(json.dumps(receipt, indent=2))


def _build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(prog="exactory-draft", description=__doc__,
                                     allow_abbrev=False)
    commands = parser.add_subparsers(dest="command", required=True)

    init = commands.add_parser("init", allow_abbrev=False,
                               help="Create the draft workspace layout.")
    init.add_argument("--dir", default=".",
                      help="Workspace directory (default: the current directory).")
    init.add_argument("--title", required=True, help="Working title of the paper.")
    init.add_argument("--category", required=True,
                      help="arXiv taxonomy category, for example cs.MA.")
    init.add_argument("--corpus", default="arxiv",
                      help="Corpus the cohort is stated against (default: arxiv).")
    init.set_defaults(handler=_run_init)
    add_identity(init, required=False)

    deposit = commands.add_parser("deposit", allow_abbrev=False,
                                  help="Deposit the built PDF to Zenodo.")
    deposit.add_argument("--production", action="store_true",
                         help="Use zenodo.org (default: sandbox.zenodo.org).")
    deposit.add_argument("--publish", action="store_true",
                         help="Publish the record (default: leave it as a draft).")
    deposit.add_argument("--new-version", action="store_true", dest="new_version",
                         help="Open a new version of the deposit recorded in"
                              " .exactory/deposit.json instead of creating a"
                              " fresh record.")
    deposit.add_argument("--confirm-publish", action="store_true",
                         help="Confirm a production publish. Add this flag only after"
                              " the user approves, because a published DOI is permanent.")
    deposit.add_argument("--pdf",
                         help="Path of the PDF (default: the newest .pdf under draft/)."
                              " It is uploaded as paper.pdf.")
    deposit.add_argument("--abstract-file", required=True, dest="abstract_file",
                         help="Path of a plain-text file holding the paper's abstract."
                              " It opens the record's description on Zenodo.")
    deposit.add_argument("--sources",
                         help="Path of an optional sources archive (zip or tarball) to attach.")
    deposit.add_argument("--creator", action="append", required=True,
                         help='Author as "Family name, Given names". Repeat for more authors.')
    deposit.set_defaults(handler=_run_deposit)
    add_identity(deposit, required=False)
    reconcile = commands.add_parser("reconcile", allow_abbrev=False, help="Settle the claimed step of a saved deposit intent, then continue that deposit.")
    reconcile.add_argument("intent_id")
    reconcile.set_defaults(handler=_run_reconcile)

    return parser


def main() -> None:
    args = _build_parser().parse_args()
    try:
        args.handler(args)
    except ResearchError as error:
        _exit_with_error(json.dumps({"error": error.as_dict()}))


if __name__ == "__main__":
    main()
