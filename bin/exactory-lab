#!/usr/bin/env python3
"""exactory-lab: the study workspace behind Exactory AI Science.

One study is one workspace: the folder this command creates holds the human
context intake, the cohort doctrine, the idea, the experiments, and the draft
the other exactory commands work on. This command owns the study state machine
(`.exactory/study.json`), the append-only decision log
(`.exactory/decisions.jsonl`), and the execution of experiment scripts through
pluggable compute backends. The intelligence lives in the skills; this file
does the mechanical bookkeeping, standard library only.
"""

from __future__ import annotations

import argparse
import json
import os
import shutil
import subprocess
import sys
import time
from pathlib import Path

# The release version has one definition: the plugin manifest. Deriving the
# User-Agent from it at boot keeps the two from drifting apart.
_PLUGIN_VERSION = json.loads(
    (Path(__file__).resolve().parent.parent / ".claude-plugin" / "plugin.json")
    .read_text(encoding="utf-8")
)["version"]
_USER_AGENT = f"exactory-lab/{_PLUGIN_VERSION}"

_STUDY_STATE_PATH = Path(".exactory") / "study.json"

_STAGES = (
    "initiate",
    "cohort",
    "ideate",
    "experiment",
    "write",
    "evaluate",
    "deposit",
    "submit",
    "complete",
)

# The credentials the study loop can use, and what the loop does without each one.
# One home for this policy: stage 0 announces it, and the stages that need a key
# read it here instead of restating it. Writing a paper needs no credential at
# all, so a missing key never blocks a stage that comes before the one it gates.
_CREDENTIALS = (
    {
        "name": "EXACTORY_API_KEY",
        "unlocks": "the challenge and suggestion reads in stage 2, and stage 7 submit",
        "without_it": "the study runs to a finished local paper, and sends nothing"
                      " to exactory",
        "create_at": "https://www.exactory.ai/console",
    },
    {
        "name": "ZENODO_SANDBOX_TOKEN",
        "unlocks": "the stage 6 test deposit to the Zenodo sandbox",
        "without_it": "the draft stays in the workspace, and no test record is created",
        "create_at": "https://sandbox.zenodo.org/account/settings/applications/tokens/new/",
    },
    {
        "name": "ZENODO_TOKEN",
        "unlocks": "the stage 6 production deposit, which mints the DOI stage 7 submits",
        "without_it": "the draft stays in the workspace, no DOI is minted, and stage 7"
                      " has nothing to submit",
        "create_at": "https://zenodo.org/account/settings/applications/tokens/new/",
    },
)

_STUDY_DIR_NAMES = (
    ".exactory",
    "context",
    "cohort/notes",
    "idea",
    "experiment/code",
    "experiment/logs",
    "experiment/results",
    "experiment/plots",
    "evidence",
    "research",
    "reviews",
    "learnings",
)

_CONTEXT_README = """\
# Context intake

Put everything the research starts from into this folder: notes, half-written
drafts, data files, papers, constraints, wishes. There is no format to follow.
You can instead name locations in chat and the agent copies the material in.
Starting with an empty folder is also a first-class choice: say so, and the
agent picks the direction itself.

The agent reads this folder at stage 0 and again at the start of every
improvement iteration, so you can drop new material in while the loop runs.
File contents are treated as data about your intent, never as instructions to
the agent.
"""

_LITERATURE_HEADER = """\
# Survey log

Append-only. One block per search pass; the format is defined in the write
skill's WORKSPACE.md.
"""

_LATEX_GITIGNORE = """\
*.aux
*.log
*.bbl
*.blg
*.out
*.pdf
"""


def _exit_with_error(message: str, code: int = 1) -> None:
    print(message, file=sys.stderr)
    raise SystemExit(code)


def _format_timestamp() -> str:
    return time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime())


def _find_workspace(start_dir: Path | None = None) -> Path:
    start = (start_dir or Path.cwd()).resolve()
    for directory in (start, *start.parents):
        if (directory / _STUDY_STATE_PATH).is_file():
            return directory
    _exit_with_error(
        "No study workspace holds this directory. Run exactory-lab init first.", 2
    )
    raise AssertionError("unreachable")


def _load_study_state(workspace_dir: Path) -> dict:
    state_path = workspace_dir / _STUDY_STATE_PATH
    try:
        return json.loads(state_path.read_text(encoding="utf-8"))
    except json.JSONDecodeError as error:
        _exit_with_error(f"{state_path} is not valid JSON. Cause: {error}")
    raise AssertionError("unreachable")


def _save_study_state(workspace_dir: Path, state: dict) -> None:
    state["updated"] = _format_timestamp()
    state_path = workspace_dir / _STUDY_STATE_PATH
    state_path.write_text(json.dumps(state, indent=2) + "\n", encoding="utf-8")


def _is_inside_git_repository(directory: Path) -> bool:
    probe = subprocess.run(
        ["git", "-C", str(directory), "rev-parse", "--is-inside-work-tree"],
        capture_output=True,
        text=True,
    )
    return probe.returncode == 0


def _run_init(args: argparse.Namespace) -> None:
    workspace_dir = Path(args.dir)
    state_path = workspace_dir / _STUDY_STATE_PATH
    if state_path.exists():
        _exit_with_error(f"{state_path} already exists."
                         " This directory is already a study workspace.")
    for dir_name in _STUDY_DIR_NAMES:
        (workspace_dir / dir_name).mkdir(parents=True, exist_ok=True)
    now = _format_timestamp()
    state = {
        "version": 1,
        "slug": args.slug,
        "stage": "initiate",
        "status": "pending",
        "autopilot": True,
        "waiting": "context",
        "loop": {"target": None, "budget": None, "notes": ""},
        "created": now,
        "updated": now,
    }
    state_path.write_text(json.dumps(state, indent=2) + "\n", encoding="utf-8")
    (workspace_dir / "context" / "README.md").write_text(
        _CONTEXT_README, encoding="utf-8"
    )
    literature_path = workspace_dir / "research" / "literature.md"
    if not literature_path.exists():
        literature_path.write_text(_LITERATURE_HEADER, encoding="utf-8")
    if not _is_inside_git_repository(workspace_dir):
        (workspace_dir / ".gitignore").write_text(_LATEX_GITIGNORE, encoding="utf-8")
        subprocess.run(
            ["git", "init", "-q", "-b", "main", str(workspace_dir)], check=True
        )
    print(f"Created the study workspace in {workspace_dir.resolve()}.")
    print("Stage 0 waits here: put the starting context into context/,"
          " or say to start from nothing.")


def _run_keys(args: argparse.Namespace) -> None:
    """Report which credentials are present. The values themselves are never read out."""
    report = {
        credential["name"]: {
            "set": os.environ.get(credential["name"], "").strip() != "",
            "unlocks": credential["unlocks"],
            "without_it": credential["without_it"],
            "create_at": credential["create_at"],
        }
        for credential in _CREDENTIALS
    }
    print(json.dumps(report, indent=2))


def _run_state_show(args: argparse.Namespace) -> None:
    workspace_dir = _find_workspace()
    print(json.dumps(_load_study_state(workspace_dir), indent=2))


def _run_state_set(args: argparse.Namespace) -> None:
    workspace_dir = _find_workspace()
    state = _load_study_state(workspace_dir)
    if args.stage is not None:
        state["stage"] = args.stage
    if args.status is not None:
        state["status"] = args.status
    if args.autopilot is not None:
        state["autopilot"] = args.autopilot == "on"
    if args.waiting is not None:
        state["waiting"] = None if args.waiting == "none" else args.waiting
    if args.loop_target is not None:
        state["loop"]["target"] = args.loop_target
    if args.loop_budget is not None:
        state["loop"]["budget"] = args.loop_budget
    if args.loop_notes is not None:
        state["loop"]["notes"] = args.loop_notes
    _save_study_state(workspace_dir, state)
    print(json.dumps(state, indent=2))


def _run_decide(args: argparse.Namespace) -> None:
    workspace_dir = _find_workspace()
    stage = args.stage or _load_study_state(workspace_dir)["stage"]
    entry = {
        "ts": _format_timestamp(),
        "stage": stage,
        "decision": args.decision,
        "why": args.why,
        "evidence": args.evidence or "",
    }
    log_path = workspace_dir / ".exactory" / "decisions.jsonl"
    with log_path.open("a", encoding="utf-8") as log_file:
        log_file.write(json.dumps(entry) + "\n")
    print(json.dumps(entry, indent=2))


def _parse_metric_from_stdout(stdout_text: str) -> dict | None:
    metric = None
    for line in stdout_text.splitlines():
        stripped_line = line.strip()
        if not (stripped_line.startswith("{") and stripped_line.endswith("}")):
            continue
        try:
            candidate = json.loads(stripped_line)
        except ValueError:
            continue
        if isinstance(candidate, dict) and "metric" in candidate:
            metric = candidate
    return metric


def _write_run_log(experiment_dir: Path, node: str, command_line: str,
                   returncode: int, duration_s: float,
                   stdout_text: str, stderr_text: str) -> None:
    log_path = experiment_dir / "logs" / f"{node}.log"
    log_path.parent.mkdir(parents=True, exist_ok=True)
    log_path.write_text(
        f"$ {command_line}\n"
        f"# cwd={experiment_dir}\n"
        f"# rc={returncode} duration={duration_s}s\n"
        f"\n----- STDOUT -----\n{stdout_text}"
        f"\n----- STDERR -----\n{stderr_text}\n",
        encoding="utf-8",
    )


def _build_run_record(node: str, backend: str, returncode: int, timed_out: bool,
                      duration_s: float, metric: dict | None, seed: int | None,
                      stderr_text: str) -> dict:
    is_buggy = returncode != 0 or timed_out or metric is None
    return {
        "node": node,
        "ok": not is_buggy,
        "is_buggy": is_buggy,
        "returncode": returncode,
        "timed_out": timed_out,
        "duration_s": duration_s,
        "metric": metric,
        "seed": seed,
        "log": f"experiment/logs/{node}.log",
        "stderr_tail": stderr_text[-800:],
        "backend": backend,
    }


def _execute_script_in(run_root: Path, script_path: Path, node: str,
                       timeout: float, seed: int | None, backend: str) -> dict:
    """Run the script with run_root as cwd; logs/ and results/ live under it."""
    env = os.environ.copy()
    if seed is not None:
        env["EXACTORY_LAB_SEED"] = str(seed)
    start = time.monotonic()
    timed_out = False
    try:
        completed = subprocess.run(
            [sys.executable, str(script_path)],
            cwd=str(run_root), env=env,
            capture_output=True, text=True, timeout=timeout,
        )
        returncode = completed.returncode
        stdout_text = completed.stdout
        stderr_text = completed.stderr
    except subprocess.TimeoutExpired as error:
        timed_out = True
        returncode = -1
        stdout_text = error.stdout or ""
        stderr_text = (error.stderr or "") + f"\n[exactory-lab] timeout after {timeout}s"
    duration_s = round(time.monotonic() - start, 3)
    metric = _parse_metric_from_stdout(stdout_text)
    if metric is None:
        results_path = run_root / "results" / f"{node}.json"
        if results_path.is_file():
            try:
                metric = json.loads(results_path.read_text(encoding="utf-8"))
            except ValueError:
                metric = None
    _write_run_log(run_root, node, f"{sys.executable} {script_path}",
                   returncode, duration_s, stdout_text, stderr_text)
    return _build_run_record(node, backend, returncode, timed_out, duration_s,
                             metric, seed, stderr_text)


def _execute_local(workspace_dir: Path, script_path: Path, node: str,
                   timeout: float, seed: int | None) -> dict:
    return _execute_script_in(workspace_dir / "experiment", script_path, node,
                              timeout, seed, "local")


# ------------------------------------------------------- the colab backend
#
# Compute only, never an LLM. The transport is one shared folder (a Google
# Drive mirror): the client writes jobs/<id>/{code/, job.json, READY}, the
# runner notebook claims a job with PROCESSED, executes it on the GPU
# runtime, and writes results/<id>/{logs/, results/, plots/, DONE}. READY
# and DONE are written last on their side of the handoff, and the runner
# rewrites RUNNER_ALIVE as a heartbeat each poll.

_RUNNER_ALIVE_FILE_NAME = "RUNNER_ALIVE"


def _read_colab_sync_root() -> Path | None:
    raw_dir = os.environ.get("EXACTORY_LAB_COLAB_DIR", "").strip()
    return Path(raw_dir).expanduser() if raw_dir else None


def _read_colab_interval(env_name: str, default_seconds: float) -> float:
    try:
        return float(os.environ.get(env_name, ""))
    except ValueError:
        return default_seconds


def _is_runner_alive(sync_root: Path, max_age_seconds: float = 180.0) -> bool:
    alive_path = sync_root / _RUNNER_ALIVE_FILE_NAME
    try:
        heartbeat = float(alive_path.read_text(encoding="utf-8").strip())
    except (OSError, ValueError):
        return False
    return time.time() - heartbeat <= max_age_seconds


def _build_colab_error_record(run_root: Path, node: str, seed: int | None,
                              message: str) -> dict:
    _write_run_log(run_root, node, "(colab backend)", -1, 0.0, "", message)
    return _build_run_record(node, "colab", -1, False, 0.0, None, seed, message)


def _execute_colab(workspace_dir: Path, script_path: Path, node: str,
                   timeout: float, seed: int | None) -> dict:
    experiment_dir = workspace_dir / "experiment"
    sync_root = _read_colab_sync_root()
    if sync_root is None or not sync_root.is_dir():
        return _build_colab_error_record(
            experiment_dir, node, seed,
            "EXACTORY_LAB_COLAB_DIR is not set to an existing directory."
            " Point it at the local mirror of the runner's Drive folder.",
        )
    slug = _load_study_state(workspace_dir)["slug"]
    job_id = f"{slug}__{node}__{int(time.time())}"
    job_dir = sync_root / "jobs" / job_id
    shutil.copytree(experiment_dir / "code", job_dir / "code",
                    ignore=shutil.ignore_patterns("__pycache__", "*.pyc"))
    job = {
        "job_id": job_id,
        "slug": slug,
        "node": node,
        "script": str(script_path.relative_to(experiment_dir.resolve())),
        "timeout": timeout,
        "seed": seed,
        "created": time.time(),
    }
    (job_dir / "job.json").write_text(json.dumps(job, indent=2) + "\n",
                                      encoding="utf-8")
    time.sleep(_read_colab_interval("EXACTORY_LAB_COLAB_SYNC_WAIT", 10.0))
    (job_dir / "READY").write_text(str(time.time()), encoding="utf-8")

    result_dir = sync_root / "results" / job_id
    poll_seconds = _read_colab_interval("EXACTORY_LAB_COLAB_POLL", 10.0)
    deadline = time.monotonic() + timeout + _read_colab_interval(
        "EXACTORY_LAB_COLAB_WAIT", 1800.0
    )
    while not (result_dir / "DONE").is_file():
        if time.monotonic() >= deadline:
            message = f"The colab runner did not finish job {job_id} in time."
            if not _is_runner_alive(sync_root):
                message += (" No runner heartbeat: start colab_runner.ipynb"
                            " on a GPU runtime, or run this node locally.")
            return _build_colab_error_record(experiment_dir, node, seed, message)
        time.sleep(poll_seconds)

    for source_name, target_dir in (("logs", experiment_dir / "logs"),
                                    ("results", experiment_dir / "results"),
                                    ("plots", experiment_dir / "plots")):
        source_dir = result_dir / source_name
        if source_dir.is_dir():
            target_dir.mkdir(parents=True, exist_ok=True)
            for source_file in source_dir.iterdir():
                shutil.copy2(source_file, target_dir / source_file.name)
    record = json.loads(
        (experiment_dir / "results" / f"{node}.json").read_text(encoding="utf-8")
    )
    record["backend"] = "colab"
    record["log"] = f"experiment/logs/{node}.log"
    return record


def _process_colab_job(sync_root: Path, job_dir: Path) -> None:
    job = json.loads((job_dir / "job.json").read_text(encoding="utf-8"))
    work_dir = sync_root / "_work" / job["job_id"]
    if work_dir.exists():
        shutil.rmtree(work_dir)
    shutil.copytree(job_dir / "code", work_dir / "code")
    for dir_name in ("logs", "results", "plots"):
        (work_dir / dir_name).mkdir(parents=True, exist_ok=True)
    record = _execute_script_in(work_dir, work_dir / job["script"], job["node"],
                                float(job["timeout"]), job["seed"], "colab")
    (work_dir / "results" / f"{job['node']}.json").write_text(
        json.dumps(record, indent=2) + "\n", encoding="utf-8"
    )
    result_dir = sync_root / "results" / job["job_id"]
    for dir_name in ("logs", "results", "plots"):
        target_dir = result_dir / dir_name
        target_dir.mkdir(parents=True, exist_ok=True)
        for source_file in (work_dir / dir_name).iterdir():
            shutil.copy2(source_file, target_dir / source_file.name)
    (result_dir / "DONE").write_text(str(time.time()), encoding="utf-8")


def _serve_scan_once(sync_root: Path) -> bool:
    """Claim and process the oldest unprocessed READY job. True if one ran."""
    (sync_root / _RUNNER_ALIVE_FILE_NAME).write_text(str(time.time()),
                                                     encoding="utf-8")
    jobs_dir = sync_root / "jobs"
    if not jobs_dir.is_dir():
        return False
    for ready_path in sorted(jobs_dir.glob("*/READY")):
        job_dir = ready_path.parent
        if (job_dir / "PROCESSED").exists():
            continue
        (job_dir / "PROCESSED").write_text(str(time.time()), encoding="utf-8")
        _process_colab_job(sync_root, job_dir)
        return True
    return False


def _require_colab_sync_root() -> Path:
    sync_root = _read_colab_sync_root()
    if sync_root is None or not sync_root.is_dir():
        _exit_with_error(
            "EXACTORY_LAB_COLAB_DIR is not set to an existing directory.", 2
        )
    return sync_root


def _run_colab_status(args: argparse.Namespace) -> None:
    sync_root = _require_colab_sync_root()
    runner_alive = _is_runner_alive(sync_root, args.max_age)
    print(json.dumps({"ok": True, "runner_alive": runner_alive,
                      "sync_root": str(sync_root)}))
    if not runner_alive:
        raise SystemExit(1)


def _run_colab_serve(args: argparse.Namespace) -> None:
    sync_root = _require_colab_sync_root()
    poll_seconds = args.poll or _read_colab_interval("EXACTORY_LAB_COLAB_POLL", 10.0)
    while True:
        processed = _serve_scan_once(sync_root)
        if args.once:
            return
        if not processed:
            time.sleep(poll_seconds)


_BACKENDS = {"local": _execute_local, "colab": _execute_colab}


def _run_run(args: argparse.Namespace) -> None:
    workspace_dir = _find_workspace()
    experiment_dir = (workspace_dir / "experiment").resolve()
    script_path = (experiment_dir / args.script).resolve()
    if not script_path.is_file() or experiment_dir not in script_path.parents:
        _exit_with_error(
            f"The script must be an existing file under {experiment_dir}."
            " Pass its path relative to experiment/, e.g. code/n3.py.", 2,
        )
    node = script_path.stem
    record = _BACKENDS[args.backend](workspace_dir, script_path, node,
                                     args.timeout, args.seed)
    results_path = experiment_dir / "results" / f"{node}.json"
    results_path.parent.mkdir(parents=True, exist_ok=True)
    results_path.write_text(json.dumps(record, indent=2) + "\n", encoding="utf-8")
    print(json.dumps(record))
    if not record["ok"]:
        raise SystemExit(1)


def _build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(
        prog="exactory-lab",
        description="Own the Exactory AI Science study workspace: state,"
                    " decisions, and experiment execution.",
    )
    commands = parser.add_subparsers(dest="command", required=True)

    init = commands.add_parser("init", allow_abbrev=False,
                               help="Create a study workspace.")
    init.add_argument("--dir", default=".",
                      help="Directory to create the workspace in. Default: here.")
    init.add_argument("--slug", required=True,
                      help="Short name of the study, used in job ids and records.")
    init.set_defaults(handler=_run_init)

    keys = commands.add_parser(
        "keys", allow_abbrev=False,
        help="Report which credentials are set, and what the study does without each."
    )
    keys.set_defaults(handler=_run_keys)

    state = commands.add_parser("state", allow_abbrev=False,
                                help="Read or advance the study state machine.")
    state_commands = state.add_subparsers(dest="state_command", required=True)
    show = state_commands.add_parser("show", allow_abbrev=False,
                                     help="Print the study state.")
    show.set_defaults(handler=_run_state_show)
    state_set = state_commands.add_parser("set", allow_abbrev=False,
                                          help="Mutate the given study state keys.")
    state_set.add_argument("--stage", choices=_STAGES,
                           help="The stage the study is in.")
    state_set.add_argument("--status",
                           help="Free-form status word, e.g. pending, running, done.")
    state_set.add_argument("--autopilot", choices=("on", "off"),
                           help="Whether the loop advances without stopping.")
    state_set.add_argument("--waiting",
                           help="Park the run on a named wait; 'none' releases it.")
    state_set.add_argument("--loop-target", type=float, dest="loop_target",
                           help="Overall score that stops the improvement loop.")
    state_set.add_argument("--loop-budget", type=int, dest="loop_budget",
                           help="Iteration budget of the improvement loop.")
    state_set.add_argument("--loop-notes", dest="loop_notes",
                           help="The user's pacing policy, in their own words.")
    state_set.set_defaults(handler=_run_state_set)

    decide = commands.add_parser("decide", allow_abbrev=False,
                                 help="Append one entry to the decision log.")
    decide.add_argument("--decision", required=True,
                        help="What was decided, in one sentence.")
    decide.add_argument("--why", required=True,
                        help="Why this over the alternatives.")
    decide.add_argument("--stage", choices=_STAGES,
                        help="Stage the decision belongs to. Default: the current one.")
    decide.add_argument("--evidence",
                        help="File or result the decision rests on.")
    decide.set_defaults(handler=_run_decide)

    run = commands.add_parser("run", allow_abbrev=False,
                              help="Execute one experiment script and record"
                                   " its result.")
    run.add_argument("script",
                     help="Path relative to experiment/, e.g. code/n3.py.")
    run.add_argument("--backend", choices=sorted(_BACKENDS), default="local",
                     help="Compute backend that runs the script.")
    run.add_argument("--timeout", type=float, default=1800.0,
                     help="Seconds before the run is killed. Default: 1800.")
    run.add_argument("--seed", type=int,
                     help="Seed exported to the script as EXACTORY_LAB_SEED.")
    run.set_defaults(handler=_run_run)

    colab_status = commands.add_parser("colab-status", allow_abbrev=False,
                                       help="Report whether a colab runner is"
                                            " alive on the sync folder.")
    colab_status.add_argument("--max-age", type=float, default=180.0,
                              dest="max_age",
                              help="Heartbeat age in seconds that still counts"
                                   " as alive. Default: 180.")
    colab_status.set_defaults(handler=_run_colab_status)

    colab_serve = commands.add_parser("colab-serve", allow_abbrev=False,
                                      help="Run the job loop the colab notebook"
                                           " runs; useful as a local stand-in.")
    colab_serve.add_argument("--once", action="store_true",
                             help="Scan for one job, then exit.")
    colab_serve.add_argument("--poll", type=float,
                             help="Seconds between scans. Default:"
                                  " EXACTORY_LAB_COLAB_POLL or 10.")
    colab_serve.set_defaults(handler=_run_colab_serve)

    return parser


def main() -> None:
    args = _build_parser().parse_args()
    args.handler(args)


if __name__ == "__main__":
    main()
