#!/usr/bin/env python3
"""exactory-predict: deterministic steps of the exactory verifier.

Two commands:
  cohort   - freeze the cohort definition, from the task's own fields (no network) or,
             as a fallback, by reading the paper's source metadata
  compose  - turn a stated prediction into a valid review payload

The model decides the numbers. This tool does the arithmetic and the JSON, so the
payload cannot drift from the contract by hand-editing.
"""

from __future__ import annotations

import argparse
import json
import math
import os
import sys
import urllib.parse
import urllib.request
import xml.etree.ElementTree as ET
from datetime import date, timedelta
from pathlib import Path

_ARXIV_API_URL = "https://export.arxiv.org/api/query"
_ZENODO_API_URL = "https://zenodo.org/api/records"
_TIMEOUT_SECONDS = 30

# The release version has one definition: the plugin manifest. Deriving the
# User-Agent from it at boot keeps the two from drifting apart.
_PLUGIN_VERSION = json.loads(
    (Path(__file__).resolve().parent.parent / ".claude-plugin" / "plugin.json")
    .read_text(encoding="utf-8")
)["version"]
_USER_AGENT = f"exactory-predict/{_PLUGIN_VERSION}"

# v1 provisional measurement ages (design 2026-08-06 §5). Frozen into every payload,
# so a later per-field refinement changes future predictions only.
_INITIAL_AGE_MONTHS = 12
_LIFELONG_AGE_MONTHS = 60

# The cohort spans this many full calendar months, and it ends before the paper's
# own publication month, so the cohort already exists when the prediction is made
# (plan 2026-08-11 D1, D2).
_COHORT_WINDOW_MONTHS = 6

# The verifier's own floor: a sigma below this states a certainty about citation
# futures that no evidence supports.
_SIGMA_FLOOR = 0.3
_SIGMA_CEILING = 10.0
_LOGIT_BOUND = 10.0
_DELTA_BOUND = 20.0

# The server's bounds on a rationale, in UTF-16 code units. A sectioned rationale
# holds the same total text as a one-block one, so the client refuses a file the
# server would reject at the boundary anyway.
_MAX_SECTION_COUNT = 20
_MAX_HEADING_UNITS = 120
_MAX_BODY_UNITS = 4000
_MAX_RATIONALE_UNITS = 8000

_ATOM_NS = {"atom": "http://www.w3.org/2005/Atom", "arxiv": "http://arxiv.org/schemas/atom"}


def _exit_with_error(message: str, code: int = 1) -> None:
    print(message, file=sys.stderr)
    sys.exit(code)


def _compute_cohort_window(published: str) -> tuple[str, str]:
    """Map an ISO date to the six full calendar months that end with the month
    before it. The rule has two implementations: the server recomputes it from the
    paper it already holds and rejects a payload whose window disagrees, so this
    one cannot drift away from it in silence."""
    year, month = int(published[0:4]), int(published[5:7])
    # The day before the first of the publication month is the last day of the
    # month before it, February and leap years included.
    window_end = date(year, month, 1) - timedelta(days=1)
    start_year, start_month_index = divmod(
        12 * year + (month - 1) - _COHORT_WINDOW_MONTHS, 12
    )
    window_start = date(start_year, start_month_index + 1, 1)
    return window_start.isoformat(), window_end.isoformat()


def _read_arxiv_cohort_inputs(arxiv_id: str) -> tuple[str, str]:
    """Return the paper's primary category and publication date, both from arXiv."""
    query = urllib.parse.urlencode({"id_list": arxiv_id})
    request = urllib.request.Request(
        f"{_ARXIV_API_URL}?{query}", headers={"User-Agent": _USER_AGENT}
    )
    try:
        with urllib.request.urlopen(request, timeout=_TIMEOUT_SECONDS) as response:
            feed = ET.parse(response)
    except OSError as error:
        _exit_with_error(f"The client cannot reach the arXiv API. Cause: {error}."
                         " Make sure that the network is available."
                         " Then run the command again.")

    entry = feed.find("atom:entry", _ATOM_NS)
    category = None if entry is None else entry.find("arxiv:primary_category", _ATOM_NS)
    published = None if entry is None else entry.findtext("atom:published", None, _ATOM_NS)
    if entry is None or category is None or published is None:
        _exit_with_error(f"The arXiv API returned no usable entry for id {arxiv_id}."
                         " Make sure that the arXiv id is correct.")

    return category.get("term"), published


def _read_zenodo_published_date(record_id: str) -> str:
    """Return the record's publication date. Zenodo carries no field classification."""
    request = urllib.request.Request(
        f"{_ZENODO_API_URL}/{record_id}", headers={"User-Agent": _USER_AGENT}
    )
    try:
        with urllib.request.urlopen(request, timeout=_TIMEOUT_SECONDS) as response:
            record = json.load(response)
    except OSError as error:
        _exit_with_error(f"The client cannot reach the Zenodo API. Cause: {error}."
                         " Make sure that the network is available."
                         " Then run the command again.")

    published = record.get("metadata", {}).get("publication_date")
    if not published:
        _exit_with_error(f"The Zenodo record {record_id} carries no publication date."
                         " Pass --published together with --category and --corpus"
                         " instead.")
    return published


def _run_cohort(args: argparse.Namespace) -> None:
    # A paper is ranked against the canonical corpus of its field, whatever source it was
    # submitted from (design 2026-08-06 §4). The task API now carries primaryCategory and
    # publishedAt (arXiv) or a verifier-stated corpus/category and publishedAt (Zenodo)
    # directly, so --published together with --category and --corpus computes the cohort
    # with no network call. --arxiv-id and --zenodo-id remain as fallbacks that read the
    # source API, for a task that predates those fields.
    sources_given = sum(bool(value) for value in (args.published, args.arxiv_id, args.zenodo_id))
    if sources_given == 0:
        _exit_with_error(
            "Pass a source: --published together with --category and --corpus,"
            " --arxiv-id, or --zenodo-id."
        )
    if sources_given > 1:
        _exit_with_error(
            "Pass exactly one source: --published, --arxiv-id, or --zenodo-id."
            " Combining them is ambiguous."
        )

    if args.published:
        if not (args.category and args.corpus):
            _exit_with_error(
                "--published needs --category and --corpus together: this is the"
                " direct-input path, computed with no network call."
            )
        corpus, category, published = args.corpus, args.category, args.published
    elif args.arxiv_id:
        category, published = _read_arxiv_cohort_inputs(args.arxiv_id)
        corpus = args.corpus or "arxiv"
        category = args.category or category
    else:
        if not (args.corpus and args.category):
            _exit_with_error(
                "A Zenodo paper needs --corpus and --category:"
                " Zenodo records carry no field classification."
            )
        corpus, category = args.corpus, args.category
        published = _read_zenodo_published_date(args.zenodo_id)

    window_start, window_end = _compute_cohort_window(published)
    json.dump(
        {
            "corpus": corpus,
            "primaryCategory": category,
            "windowStart": window_start,
            "windowEnd": window_end,
            "initialAgeMonths": _INITIAL_AGE_MONTHS,
            "lifelongAgeMonths": _LIFELONG_AGE_MONTHS,
        },
        sys.stdout,
        indent=2,
    )
    print()


def _convert_percentile_to_logit(percentile: float) -> float:
    if not 0.0 < percentile < 1.0:
        _exit_with_error(
            f"The percentile must be between 0 and 1, exclusive."
            f" The value {percentile} is outside this range."
        )
    logit = math.log(percentile / (1.0 - percentile))
    if abs(logit) > _LOGIT_BOUND:
        _exit_with_error(
            f"The percentile {percentile} is too close to 0 or 1 to represent."
            " Use a percentile between 0.0001 and 0.9999."
        )
    return round(logit, 4)


def _require_sigma_in_range(name: str, sigma: float) -> None:
    if sigma < _SIGMA_FLOOR:
        _exit_with_error(
            f"{name} is {sigma}, below the floor of {_SIGMA_FLOOR}. A narrower"
            " distribution states a certainty the evidence cannot support. Widen it."
        )
    if sigma > _SIGMA_CEILING:
        _exit_with_error(f"{name} is {sigma}, above the ceiling of {_SIGMA_CEILING}.")


def _truncate_to_utf16_units(text: str, limit: int) -> str:
    """The server bounds claim text in UTF-16 code units (JavaScript string length),
    where a non-BMP character counts as two. Truncating by Python code points would
    pass text the server then rejects."""
    units = 0
    for index, char in enumerate(text):
        units += 2 if ord(char) > 0xFFFF else 1
        if units > limit:
            return text[:index]
    return text


def _count_utf16_units(text: str) -> int:
    """Length in UTF-16 code units, the unit the server's bounds count.
    surrogatepass counts a lone surrogate as one unit, the way a JavaScript
    string does, instead of raising UnicodeEncodeError."""
    return len(text.encode("utf-16-le", "surrogatepass")) // 2


def _read_rationale_sections(path: str) -> list[dict]:
    """Parse a JSON section list in the shape the claim payload carries:
    [{heading, body}]. Same file convention as `exactory-check lookup --refs-json`."""
    try:
        with open(path, encoding="utf-8") as handle:
            sections = json.load(handle)
    except FileNotFoundError:
        _exit_with_error(f"The file {path} does not exist.")
    except json.JSONDecodeError as error:
        _exit_with_error(f"The file {path} is not valid JSON. Cause: {error}")

    if not isinstance(sections, list) or not all(
        isinstance(section, dict) for section in sections
    ):
        _exit_with_error(f"The file {path} does not hold a JSON array of section"
                         ' objects. Each object holds a "heading" and a "body".')
    if not 1 <= len(sections) <= _MAX_SECTION_COUNT:
        _exit_with_error(f"The file {path} holds {len(sections)} sections."
                         f" Write 1 to {_MAX_SECTION_COUNT} sections.")

    parsed_sections = []
    for index, section in enumerate(sections, start=1):
        heading, body = section.get("heading"), section.get("body")
        if not isinstance(heading, str) or not isinstance(body, str):
            _exit_with_error(f'Section {index} needs a "heading" string and a "body"'
                             " string. Write both.")
        heading, body = heading.strip(), body.strip()
        if not 1 <= _count_utf16_units(heading) <= _MAX_HEADING_UNITS:
            _exit_with_error(f"The heading of section {index} must hold 1 to"
                             f" {_MAX_HEADING_UNITS} characters.")
        if not 1 <= _count_utf16_units(body) <= _MAX_BODY_UNITS:
            _exit_with_error(f"The body of section {index} must hold 1 to"
                             f" {_MAX_BODY_UNITS} characters.")
        parsed_sections.append({"heading": heading, "body": body})

    total_units = sum(_count_utf16_units(part["body"]) for part in parsed_sections)
    if total_units > _MAX_RATIONALE_UNITS:
        _exit_with_error(f"The bodies hold {total_units} characters together, above the"
                         f" limit of {_MAX_RATIONALE_UNITS}. Make the rationale shorter.")
    return parsed_sections


_SUGGESTION_FIELD_UNIT_BOUNDS = {
    "title": 120,
    "ground": 1000,
    "action": 2000,
    "expectedOutcome": 1000,
}


def _read_suggestions_file(path: str) -> dict:
    """Parse the {continuous, drastic} suggestion pair every evaluative claim carries
    (design 2026-08-11). Bounds mirror the server's contract in UTF-16 code units.
    Duplicated across the binaries the way _truncate_to_utf16_units is: bin/ holds
    exactly four executables, so a shared module is a file-layout change this
    validator does not get to make."""
    try:
        with open(path, encoding="utf-8") as handle:
            suggestions = json.load(handle)
    except FileNotFoundError:
        _exit_with_error(f"The file {path} does not exist.")
    except json.JSONDecodeError as error:
        _exit_with_error(f"The file {path} is not valid JSON. Cause: {error}")

    if not isinstance(suggestions, dict):
        _exit_with_error(f"The file {path} does not hold a JSON object with a"
                         ' "continuous" and a "drastic" suggestion.')
    unknown_slots = sorted(set(suggestions) - {"continuous", "drastic"})
    if unknown_slots:
        _exit_with_error(f"The file {path} carries an unknown key:"
                         f" {', '.join(unknown_slots)}."
                         ' Write exactly "continuous" and "drastic".')

    parsed = {}
    for slot in ("continuous", "drastic"):
        entry = suggestions.get(slot)
        if not isinstance(entry, dict):
            _exit_with_error(f'The file {path} is missing the "{slot}" suggestion.'
                             " Write both suggestions.")
        unknown_fields = sorted(set(entry) - set(_SUGGESTION_FIELD_UNIT_BOUNDS))
        if unknown_fields:
            _exit_with_error(f'The "{slot}" suggestion carries an unknown key:'
                             f" {', '.join(unknown_fields)}.")
        parsed_entry = {}
        for field_name, unit_bound in _SUGGESTION_FIELD_UNIT_BOUNDS.items():
            value = entry.get(field_name)
            if not isinstance(value, str) or value.strip() == "":
                _exit_with_error(f'The "{slot}" suggestion is missing "{field_name}".'
                                 " Write all four fields.")
            value = value.strip()
            if _count_utf16_units(value) > unit_bound:
                _exit_with_error(f'The "{field_name}" of the "{slot}" suggestion is'
                                 f" over the limit of {unit_bound} characters."
                                 " Make it shorter.")
            parsed_entry[field_name] = value
        parsed[slot] = parsed_entry
    return parsed


def _run_compose(args: argparse.Namespace) -> None:
    try:
        with open(args.cohort_file, encoding="utf-8") as handle:
            cohort = json.load(handle)
    except FileNotFoundError:
        _exit_with_error(f"The file {args.cohort_file} does not exist. Run cohort first.")
    except json.JSONDecodeError as error:
        _exit_with_error(f"The file {args.cohort_file} is not valid JSON. Cause: {error}")

    # One rationale shape per claim: sections render under their headings on the
    # public page, one block of text renders as one paragraph (plan 2026-08-11 D5).
    if args.sections_file:
        rationale_field = "rationaleSections"
        rationale_value = _read_rationale_sections(args.sections_file)
    else:
        try:
            with open(args.rationale_file, encoding="utf-8") as handle:
                text = handle.read().strip()
        except FileNotFoundError:
            _exit_with_error(f"The file {args.rationale_file} does not exist.")
        if text == "":
            _exit_with_error("The rationale file is empty."
                             " State the evidence behind the numbers.")
        rationale_field = "rationale"
        rationale_value = _truncate_to_utf16_units(text, _MAX_RATIONALE_UNITS)

    _require_sigma_in_range("--initial-sigma", args.initial_sigma)
    _require_sigma_in_range("--delta-sigma", args.delta_sigma)
    if abs(args.delta) > _DELTA_BOUND:
        _exit_with_error(f"--delta is {args.delta}, outside ±{_DELTA_BOUND}.")

    claim = {
        "dimension": "impact",
        "procedure": "cohort_prediction",
        rationale_field: rationale_value,
        "suggestions": _read_suggestions_file(args.suggestions_file),
        "sources": [{"url": url} for url in (args.source_url or [])],
        "payload": {
            "cohort": cohort,
            "initial": {
                "logitMean": _convert_percentile_to_logit(args.initial_percentile),
                "logitSigma": args.initial_sigma,
            },
            "lifelongDelta": {"mean": args.delta, "sigma": args.delta_sigma},
        },
    }
    if args.supersedes:
        claim["supersedesClaimId"] = args.supersedes
    # Append into an existing review file: `exactory compose-claim` writes to the same
    # file, and a prediction that overwrote those claims would silently discard them.
    review = {"claims": []}
    if os.path.exists(args.out):
        try:
            with open(args.out, encoding="utf-8") as handle:
                review = json.load(handle)
        except json.JSONDecodeError as error:
            _exit_with_error(f"The file {args.out} is not valid JSON. Cause: {error}."
                             " Correct or delete the file. Then run compose again.")
        if not isinstance(review, dict) or not isinstance(review.get("claims"), list):
            _exit_with_error(f"The file {args.out} does not hold a review object"
                             " with a claims list.")
    review["claims"].append(claim)
    with open(args.out, "w", encoding="utf-8") as handle:
        json.dump(review, handle, indent=2)
    count = len(review["claims"])
    print(f"The file {args.out} now holds {count} claim(s)."
          f" Submit with: exactory submit-review <id> --file {args.out}")


def _build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(prog="exactory-predict", description=__doc__,
                                     allow_abbrev=False)
    commands = parser.add_subparsers(dest="command", required=True)

    cohort = commands.add_parser(
        "cohort", allow_abbrev=False,
        help="Freeze the cohort definition, from the task's fields or a source API."
    )
    source = cohort.add_mutually_exclusive_group()
    source.add_argument(
        "--arxiv-id", help="For example 2301.00001. Fallback: calls the arXiv API."
    )
    source.add_argument(
        "--zenodo-id", help="A Zenodo record id, for example 21381192. Fallback:"
        " calls the Zenodo API."
    )
    cohort.add_argument(
        "--published",
        help="ISO date, for example 2026-07-15 (the task's publishedAt date part)."
        " With --category and --corpus, computes the cohort with no network call.",
    )
    cohort.add_argument(
        "--corpus",
        help="The corpus the percentile is stated against, for example arxiv."
        " Required with --published or --zenodo-id.",
    )
    cohort.add_argument(
        "--category",
        help="The field the paper is ranked within, for example cs.MA."
        " Required with --published or --zenodo-id.",
    )
    cohort.set_defaults(handler=_run_cohort)

    compose = commands.add_parser("compose", allow_abbrev=False,
                                  help="Build the review payload file.")
    compose.add_argument("--cohort-file", required=True, help="Output of the cohort command.")
    compose.add_argument(
        "--initial-percentile",
        type=float,
        required=True,
        help="Fraction of cohort papers this paper out-cites at the initial age."
        " 0.90 means top 10%%.",
    )
    compose.add_argument("--initial-sigma", type=float, required=True)
    compose.add_argument(
        "--delta",
        type=float,
        required=True,
        help="Logit-scale shift from initial to lifelong. A negative value means"
             " the paper loses rank after its start.",
    )
    compose.add_argument("--delta-sigma", type=float, required=True)
    rationale_source = compose.add_mutually_exclusive_group(required=True)
    rationale_source.add_argument(
        "--rationale-file", help="A file with the reasoning as one block of text."
    )
    rationale_source.add_argument(
        "--sections-file",
        help="A JSON file with the reasoning in sections:"
             ' [{"heading": "...", "body": "..."}]. The public page renders each'
             " section under its own heading.",
    )
    compose.add_argument(
        "--suggestions-file", required=True,
        help="A JSON file with the two next steps the prediction proposes:"
             ' {"continuous": {...}, "drastic": {...}}, each with a "title", a'
             ' "ground", an "action", and an "expectedOutcome".',
    )
    compose.add_argument(
        "--source-url", action="append",
        help="A URL the rationale leans on, for example a paper it compares against."
             " Repeat the flag for more than one URL."
             " exactory publishes the cohort's members itself, so no URL stands"
             " for the cohort.",
    )
    compose.add_argument(
        "--supersedes",
        help="The prediction of your own this one replaces. Corrections are appended:"
             " the earlier prediction keeps its date and stays scored.",
    )
    compose.add_argument("--out", default="review.json")
    compose.set_defaults(handler=_run_compose)

    return parser


def main() -> None:
    args = _build_parser().parse_args()
    args.handler(args)


if __name__ == "__main__":
    main()
