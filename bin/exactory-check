#!/usr/bin/env python3
"""exactory-check: deterministic citation integrity for a draft's references.

Three commands:
  add     - fetch the registry record for a DOI or arXiv id (Crossref, DataCite,
            arXiv) and append the rendered BibTeX entry, so no entry is written
            by hand
  verify  - check every reference against the registries and write the report
            that the deposit and submit gates read
  gate    - check offline that the report is fresh and clean, as the submit and
            deposit commands do before they send anything

The good status is verified. The blocking statuses are not_found, unresolved,
title_mismatch, and author_mismatch. The warning statuses are year_mismatch,
no_query, and network_error. A network failure is never treated as fabrication,
and a report where nothing was verified does not pass the gate. Python standard
library only.
"""

from __future__ import annotations

import argparse
import difflib
import hashlib
import json
import os
import re
import string
import sys
import time
import unicodedata
import urllib.error
import urllib.parse
import urllib.request
import xml.etree.ElementTree as ET
from pathlib import Path

_CROSSREF_API_URL = "https://api.crossref.org/works"
_DATACITE_API_URL = "https://api.datacite.org/dois"
_ARXIV_API_URL = "https://export.arxiv.org/api/query"
_OPENALEX_API_URL = "https://api.openalex.org/works"
_PUBMED_ESUMMARY_API_URL = "https://eutils.ncbi.nlm.nih.gov/entrez/eutils/esummary.fcgi"

_DEFAULT_BIB_PATH = "draft/references.bib"
_DEFAULT_REPORT_PATH = ".exactory/citation-check.json"
_CACHE_FILE_NAME = "citation-cache.json"

_TIMEOUT_SECONDS = 30
_MIN_REQUEST_INTERVAL_SECONDS = 0.6
_MAX_RETRIES = 3
_MAX_BACKOFF_SECONDS = 8.0

# No substring shortcut: a real title plus a fabricated subtitle must come out a
# mismatch, so only normalized equality or near-equality counts as a match.
_TITLE_SIMILARITY_FLOOR = 0.97
# Registry metadata itself is occasionally noisy (a one-letter typo in a name);
# a tight full-name similarity floor absorbs that without accepting a different name.
_NAME_SIMILARITY_FLOOR = 0.93

_BLOCKING_STATUSES = {"not_found", "unresolved", "title_mismatch", "author_mismatch"}
_WARNING_STATUSES = {"year_mismatch", "no_query", "network_error"}


_CONTACT_EMAIL = os.environ.get("EXACTORY_CONTACT_EMAIL", "").strip()
_USER_AGENT = (f"exactory-check/0.6.0 (mailto:{_CONTACT_EMAIL})" if _CONTACT_EMAIL
               else "exactory-check/0.6.0")


def _exit_with_error(message: str, code: int = 1) -> None:
    print(message, file=sys.stderr)
    sys.exit(code)


# ------------------------------------------------------------- network seam

_last_request_monotonic = 0.0


def _open_url(url: str, accept: str = "application/json") -> tuple[int | None, str | None]:
    """Send one polite GET request. Returns (status, body), where (None, None)
    means the network failed. Keeps a shared minimum interval between live
    requests and retries 429/503 with the Retry-After delay. Tests replace this
    function; nothing else touches the network."""
    global _last_request_monotonic
    request = urllib.request.Request(url, headers={"User-Agent": _USER_AGENT, "Accept": accept})
    backoff_seconds = 1.0
    for attempt in range(_MAX_RETRIES + 1):
        wait_seconds = _MIN_REQUEST_INTERVAL_SECONDS - (time.monotonic() - _last_request_monotonic)
        if wait_seconds > 0:
            time.sleep(wait_seconds)
        _last_request_monotonic = time.monotonic()
        try:
            with urllib.request.urlopen(request, timeout=_TIMEOUT_SECONDS) as response:
                return response.getcode(), response.read().decode("utf-8", "replace")
        except urllib.error.HTTPError as error:
            if error.code in (429, 503) and attempt < _MAX_RETRIES:
                retry_after = error.headers.get("Retry-After") if error.headers else None
                try:
                    delay_seconds = float(retry_after) if retry_after else backoff_seconds
                except ValueError:
                    delay_seconds = backoff_seconds
                time.sleep(min(delay_seconds, _MAX_BACKOFF_SECONDS))
                backoff_seconds *= 2
                continue
            return error.code, None
        except OSError:
            return None, None
    raise AssertionError("unreachable")


# --------------------------------------- BibTeX parsing (dependency-free)


def _read_delimited_value(text: str, start: int, open_char: str,
                          close_char: str) -> tuple[str, int]:
    """Read a brace-balanced (or quote-terminated) value whose opening delimiter
    is at ``start``. Returns (inner_text, index_after_close)."""
    length = len(text)
    if open_char == '"':
        index = start + 1
        pieces = []
        brace_depth = 0
        while index < length:
            char = text[index]
            if char == "{":
                brace_depth += 1
            elif char == "}":
                brace_depth = max(0, brace_depth - 1)
            elif char == '"' and brace_depth == 0:
                return "".join(pieces), index + 1
            pieces.append(char)
            index += 1
        return "".join(pieces), index
    depth = 0
    index = start
    while index < length:
        char = text[index]
        if char == open_char:
            depth += 1
        elif char == close_char:
            depth -= 1
            if depth == 0:
                return text[start + 1:index], index + 1
        index += 1
    return text[start + 1:], length


def _clean_field_value(value: str) -> str:
    """Strip LaTeX braces and collapse whitespace so values compare cleanly."""
    value = value.replace("{", "").replace("}", "")
    value = re.sub(r"\s+", " ", value)
    return value.strip().strip(",").strip()


def _parse_entry_fields(body: str) -> dict[str, str]:
    fields = {}
    index, length = 0, len(body)
    while index < length:
        while index < length and body[index] in " \t\r\n,":
            index += 1
        match = re.match(r"([A-Za-z][A-Za-z0-9_\-]*)\s*=\s*", body[index:])
        if not match:
            break
        field_name = match.group(1).lower()
        index += match.end()
        if index >= length:
            break
        char = body[index]
        if char == "{":
            value, index = _read_delimited_value(body, index, "{", "}")
        elif char == '"':
            value, index = _read_delimited_value(body, index, '"', '"')
        else:  # bare value (a number or a macro) up to the next comma
            end = index
            while end < length and body[end] != ",":
                end += 1
            value, index = body[index:end], end
        fields[field_name] = _clean_field_value(value)
    return fields


def _parse_bib(text: str) -> list[dict]:
    """Tolerant BibTeX parser. Returns a list of {type, key, ...fields} and skips
    @comment, @string, and @preamble blocks."""
    entries = []
    index, length = 0, len(text)
    while True:
        at = text.find("@", index)
        if at == -1:
            break
        end = at + 1
        while end < length and text[end].isalpha():
            end += 1
        entry_type = text[at + 1:end].lower()
        while end < length and text[end] not in "{(":
            end += 1
        if end >= length:
            break
        if text[end] == "{":
            body, index = _read_delimited_value(text, end, "{", "}")
        else:
            body, index = _read_delimited_value(text, end, "(", ")")
        if entry_type in ("comment", "string", "preamble"):
            continue
        if "," not in body:
            continue
        key, rest = body.split(",", 1)
        entry = {"type": entry_type, "key": key.strip()}
        entry.update(_parse_entry_fields(rest))
        entries.append(entry)
    return entries


# --------------------------------------------------- identifier extraction

_NEW_ARXIV_ID_RE = re.compile(r"\b(\d{4}\.\d{4,5})(v\d+)?\b")
_OLD_ARXIV_ID_RE = re.compile(r"\b([a-z\-]+(?:\.[A-Z]{2})?/\d{7})(v\d+)?\b")
_DOI_IN_TEXT_RE = re.compile(r"10\.\d{4,9}/[^\s{}\"]+")


def _extract_doi(entry: dict) -> str:
    doi = (entry.get("doi") or "").strip()
    if not doi:
        for field_name in ("url", "eprint", "note"):
            match = _DOI_IN_TEXT_RE.search(entry.get(field_name, ""))
            if match:
                doi = match.group(0)
                break
    doi = re.sub(r"^https?://(dx\.)?doi\.org/", "", doi, flags=re.IGNORECASE).strip().rstrip(".")
    if doi.lower().startswith("10.48550/arxiv"):
        return ""  # a pure arXiv DOI is better checked against the arXiv API
    return doi


def _extract_arxiv_id(entry: dict) -> str:
    prefix = (entry.get("archiveprefix") or "").lower()
    eprint = (entry.get("eprint") or "").strip()
    if "arxiv" in prefix and eprint:
        return re.sub(r"v\d+$", "", eprint)
    haystack = " ".join(
        entry.get(field_name, "")
        for field_name in ("eprint", "url", "doi", "journal", "note", "howpublished")
    )
    if "arxiv" in haystack.lower() or "arxiv" in prefix:
        match = _NEW_ARXIV_ID_RE.search(haystack) or _OLD_ARXIV_ID_RE.search(haystack)
        if match:
            return match.group(1)
    if eprint:
        match = _NEW_ARXIV_ID_RE.fullmatch(eprint) or _OLD_ARXIV_ID_RE.fullmatch(eprint)
        if match:
            return match.group(1)
    return ""


# ----------------------------------------------- title and author matching

# Characters NFKD cannot fold usefully: German eszett, ligatures, strokes, and
# Greek letters (a registry title with an epsilon must match a bib title that
# spells out "epsilon").
_TRANSLIT_MAP = {"ß": "ss", "æ": "ae", "Æ": "AE", "œ": "oe", "Œ": "OE", "ø": "o", "Ø": "O",
                 "ł": "l", "Ł": "L", "đ": "d", "Đ": "D", "þ": "th", "Þ": "Th", "ð": "d",
                 "α": "alpha", "β": "beta", "γ": "gamma", "δ": "delta", "ε": "epsilon",
                 "ϵ": "epsilon", "ζ": "zeta", "η": "eta", "θ": "theta", "ι": "iota",
                 "κ": "kappa", "λ": "lambda", "μ": "mu", "ν": "nu", "ξ": "xi", "π": "pi",
                 "ρ": "rho", "σ": "sigma", "τ": "tau", "υ": "upsilon", "φ": "phi",
                 "χ": "chi", "ψ": "psi", "ω": "omega", "Γ": "Gamma", "Δ": "Delta",
                 "Θ": "Theta", "Λ": "Lambda", "Π": "Pi", "Σ": "Sigma", "Φ": "Phi",
                 "Ψ": "Psi", "Ω": "Omega"}

# LaTeX commands that survive brace stripping. Normalized for matching only.
_TEX_WORD_RE = re.compile(
    r"\\(varepsilon|epsilon|alpha|beta|gamma|delta|zeta|theta|iota|kappa|lambda|sigma|"
    r"upsilon|omicron|omega|mu|nu|xi|pi|rho|tau|phi|chi|psi|eta|ss|ae|oe|aa|o|l|i|j)")
_TEX_ACCENT_RE = re.compile(r"\\([vcuHkbdr'\"`^~=.])")


def _fold_to_ascii(text: str) -> str:
    text = "".join(_TRANSLIT_MAP.get(char, char) for char in (text or ""))
    return unicodedata.normalize("NFKD", text).encode("ascii", "ignore").decode()


def _strip_tex_commands(text: str) -> str:
    if "\\" not in (text or ""):
        return text or ""
    text = _TEX_WORD_RE.sub(
        lambda match: "epsilon" if match.group(1) == "varepsilon" else match.group(1), text
    )
    text = _TEX_ACCENT_RE.sub("", text)  # accent commands: keep the modified letter
    return re.sub(r"\\[a-zA-Z]+\s*", " ", text)  # any remaining command: drop it


def _normalize_for_match(text: str) -> str:
    """Lowercase alphanumerics with single spaces: the comparison alphabet."""
    return re.sub(r"[^a-z0-9]+", " ", _fold_to_ascii(_strip_tex_commands(text)).lower()).strip()


def _titles_match(bib_title: str, candidate_titles: list[str]) -> bool:
    normalized_bib = _normalize_for_match(bib_title)
    for candidate in candidate_titles or []:
        normalized_candidate = _normalize_for_match(candidate)
        if not normalized_bib or not normalized_candidate:
            continue
        if normalized_bib == normalized_candidate:
            return True
        ratio = difflib.SequenceMatcher(None, normalized_bib, normalized_candidate).ratio()
        if ratio >= _TITLE_SIMILARITY_FLOOR:
            return True
    return False


def _split_name_tokens(name: str) -> list[str]:
    folded = _fold_to_ascii(_strip_tex_commands(name or "")).lower()
    folded = folded.replace("-", " ").replace(".", " ")
    return [token for token in re.sub(r"[^a-z\s]", "", folded).split() if token]


def _split_bib_authors(field: str) -> list[str]:
    """Split a BibTeX author field on ' and ' into display names, normalizing
    'Last, First' to 'First Last'. A trailing 'others' is kept as-is."""
    names = []
    for raw_name in re.split(r"\s+and\s+", (field or "").strip(), flags=re.IGNORECASE):
        raw_name = raw_name.strip().strip(",").strip()
        if not raw_name:
            continue
        if raw_name.lower() in ("others", "et al"):
            names.append("others")
            continue
        if "," in raw_name:
            family, _, given = raw_name.partition(",")
            raw_name = (given.strip() + " " + family.strip()).strip()
        names.append(raw_name)
    return names


def _names_match(name_a: str, name_b: str) -> bool:
    """One person, two spellings? The family name (last token) must match; given
    names may abbreviate to an initial but may not change."""
    tokens_a, tokens_b = _split_name_tokens(name_a), _split_name_tokens(name_b)
    if not tokens_a or not tokens_b:
        return False
    if tokens_a == tokens_b:
        return True

    def _token_matches(token_x: str, token_y: str) -> bool:
        return token_x == token_y or (
            token_x[0] == token_y[0] and (len(token_x) == 1 or len(token_y) == 1)
        )

    def _given_names_match(given_a: list, given_b: list) -> bool:
        if not given_a or not given_b:  # one side wrote the family name only
            return True
        if not _token_matches(given_a[0], given_b[0]):
            return False
        return all(_token_matches(x, y) for x, y in zip(given_a[1:], given_b[1:]))

    if tokens_a[-1] == tokens_b[-1] and _given_names_match(tokens_a[:-1], tokens_b[:-1]):
        return True
    ratio = difflib.SequenceMatcher(None, "".join(tokens_a), "".join(tokens_b)).ratio()
    return ratio >= _NAME_SIMILARITY_FLOOR


def _compare_author_lists(bib_author_field: str,
                          registry_authors: list[str]) -> tuple[bool, str]:
    """Positional comparison of the bib author list against the registry's. A
    trailing 'and others' truncation is tolerated; every listed name must match."""
    if not registry_authors:
        return True, "the registry lists no authors"
    bib_authors = _split_bib_authors(bib_author_field)
    if not bib_authors:
        return False, "the entry lists no authors"
    truncated = bib_authors[-1] == "others"
    if truncated:
        bib_authors = bib_authors[:-1]
    if not truncated and len(bib_authors) != len(registry_authors):
        return False, (f"the author count differs: the entry lists {len(bib_authors)},"
                       f" the registry lists {len(registry_authors)}")
    if len(bib_authors) > len(registry_authors):
        return False, "the entry lists more authors than the registry record"
    for position, (bib_name, registry_name) in enumerate(zip(bib_authors, registry_authors)):
        if not _names_match(bib_name, registry_name):
            return False, (f"author {position + 1} differs: the entry says '{bib_name}',"
                           f" the registry says '{registry_name}'")
    return True, "the authors match"


# ------------------------------------------------------- registry lookups
#
# Every resolver returns {"meta": {...}} on success or {"status", "detail"} on
# failure. The meta shape is shared: {source, title, titles, authors, year, doi,
# container, type} plus source-specific extras.


def _normalize_crossref_work(work: dict) -> dict:
    title = _clean_field_value((work.get("title") or [""])[0])
    subtitle = _clean_field_value((work.get("subtitle") or [""])[0])
    # Handbook chapters often embed "Chapter NN" in the Crossref title; papers
    # legitimately cite them without it.
    chapterless = re.sub(r"^chapter\s+\d+[:.\s]\s*", "", title, flags=re.IGNORECASE)
    titles = [t for t in (title, f"{title}: {subtitle}" if subtitle else "",
                          chapterless if chapterless != title else "") if t]
    authors = []
    for author in work.get("author") or []:
        full_name = " ".join(
            part for part in (author.get("given"), author.get("family")) if part
        ) or author.get("name", "")
        if full_name:
            authors.append(full_name)
    year = None
    for date_field in ("issued", "published-print", "published-online", "created"):
        date_parts = ((work.get(date_field) or {}).get("date-parts") or [[None]])[0]
        if date_parts and date_parts[0]:
            year = int(date_parts[0])
            break
    return {"source": "crossref", "title": title, "titles": titles, "authors": authors,
            "year": year, "doi": work.get("DOI", ""),
            "container": _clean_field_value((work.get("container-title") or [""])[0]),
            "type": work.get("type", ""), "volume": work.get("volume", ""),
            "number": work.get("issue", ""), "pages": work.get("page", "")}


def _resolve_doi_via_crossref(doi: str) -> dict:
    code, text = _open_url(f"{_CROSSREF_API_URL}/" + urllib.parse.quote(doi, safe=""))
    if code == 404:
        return {"status": "not_found", "detail": f"DOI {doi} is not in Crossref"}
    if code == 200 and text:
        try:
            work = json.loads(text).get("message", {})
        except ValueError:
            return {"status": "network_error",
                    "detail": "Crossref returned an unreadable response"}
        return {"meta": _normalize_crossref_work(work)}
    return {"status": "network_error",
            "detail": "Crossref was not reachable" if code is None
            else f"Crossref returned HTTP {code}"}


def _normalize_datacite_record(attributes: dict) -> dict:
    titles = [t.get("title", "") for t in attributes.get("titles") or [] if t.get("title")]
    authors = []
    for creator in attributes.get("creators") or []:
        full_name = " ".join(
            part for part in (creator.get("givenName"), creator.get("familyName")) if part
        )
        if not full_name:
            full_name = creator.get("name", "")
            if "," in full_name:
                family, _, given = full_name.partition(",")
                full_name = (given.strip() + " " + family.strip()).strip()
        if full_name:
            authors.append(full_name)
    return {"source": "datacite", "title": titles[0] if titles else "", "titles": titles,
            "authors": authors, "year": attributes.get("publicationYear"),
            "doi": attributes.get("doi", ""), "container": "", "type": ""}


def _resolve_doi_via_datacite(doi: str) -> dict:
    code, text = _open_url(f"{_DATACITE_API_URL}/" + urllib.parse.quote(doi, safe=""))
    if code == 404:
        return {"status": "not_found", "detail": f"DOI {doi} is not in DataCite"}
    if code == 200 and text:
        try:
            attributes = json.loads(text).get("data", {}).get("attributes", {})
        except ValueError:
            return {"status": "network_error",
                    "detail": "DataCite returned an unreadable response"}
        return {"meta": _normalize_datacite_record(attributes)}
    return {"status": "network_error",
            "detail": "DataCite was not reachable" if code is None
            else f"DataCite returned HTTP {code}"}


def _resolve_doi(doi: str) -> dict:
    crossref = _resolve_doi_via_crossref(doi)
    if crossref.get("status") != "not_found":
        return crossref
    datacite = _resolve_doi_via_datacite(doi)
    if datacite.get("status") == "not_found":
        return {"status": "not_found", "detail": f"DOI {doi} is not in Crossref or DataCite"}
    return datacite


_ATOM_TAG_PREFIX = "{http://www.w3.org/2005/Atom}"
_ARXIV_TAG_PREFIX = "{http://arxiv.org/schemas/atom}"


def _normalize_arxiv_entry(entry_element) -> dict:
    title = _clean_field_value(entry_element.findtext(f"{_ATOM_TAG_PREFIX}title") or "")
    authors = [_clean_field_value(author.findtext(f"{_ATOM_TAG_PREFIX}name") or "")
               for author in entry_element.findall(f"{_ATOM_TAG_PREFIX}author")]
    published = entry_element.findtext(f"{_ATOM_TAG_PREFIX}published") or ""
    entry_id = entry_element.findtext(f"{_ATOM_TAG_PREFIX}id") or ""
    id_match = re.search(r"abs/(\S+?)(v\d+)?$", entry_id)
    primary_category = entry_element.find(f"{_ARXIV_TAG_PREFIX}primary_category")
    return {"source": "arxiv", "title": title, "titles": [title],
            "authors": [author for author in authors if author],
            "year": int(published[:4]) if published[:4].isdigit() else None,
            "doi": "", "container": "", "type": "",
            "arxiv": id_match.group(1) if id_match else "",
            "primary_class": primary_category.get("term")
            if primary_category is not None else ""}


def _parse_arxiv_feed(atom_xml: str) -> list[dict] | None:
    """Parse an arXiv Atom feed into meta dicts. None means unparseable (network
    trouble); an empty list means the feed matched nothing (a real not-found)."""
    try:
        root = ET.fromstring(atom_xml)
    except ET.ParseError:
        return None
    entries = []
    for entry_element in root.findall(f"{_ATOM_TAG_PREFIX}entry"):
        # arXiv returns a synthetic error entry when nothing matches the query.
        if "/api/errors" in (entry_element.findtext(f"{_ATOM_TAG_PREFIX}id") or ""):
            continue
        entries.append(_normalize_arxiv_entry(entry_element))
    return entries


def _resolve_arxiv_id(arxiv_id: str) -> dict:
    url = f"{_ARXIV_API_URL}?id_list=" + urllib.parse.quote(arxiv_id) + "&max_results=1"
    code, text = _open_url(url, accept="application/atom+xml")
    if code != 200 or not text:
        return {"status": "network_error",
                "detail": "the arXiv API was not reachable" if code is None
                else f"the arXiv API returned HTTP {code}"}
    entries = _parse_arxiv_feed(text)
    if entries is None:
        return {"status": "network_error",
                "detail": "the arXiv API returned an unreadable response"}
    if not entries:
        return {"status": "not_found", "detail": f"arXiv id {arxiv_id} returned no entry"}
    return {"meta": entries[0]}


def _normalize_pubmed_summary(summary: dict) -> dict:
    title = summary.get("title", "").strip()
    authors = []
    for author in summary.get("authors") or []:
        name_tokens = (author.get("name") or "").split()
        if not name_tokens:
            continue
        family, initial_groups = name_tokens[0], name_tokens[1:]
        initials = [letter for group in initial_groups for letter in group]
        authors.append(" ".join(initials + [family]))
    year_match = re.search(r"\d{4}", summary.get("pubdate", ""))
    return {"source": "pubmed", "title": title, "titles": [title], "authors": authors,
            "year": int(year_match.group(0)) if year_match else None,
            "doi": "", "container": "", "type": ""}


def _resolve_pmid(pmid: str) -> dict:
    query = {"db": "pubmed", "retmode": "json", "id": pmid}
    if _CONTACT_EMAIL:
        query["tool"] = "exactory-check"
        query["email"] = _CONTACT_EMAIL
    code, text = _open_url(f"{_PUBMED_ESUMMARY_API_URL}?" + urllib.parse.urlencode(query))
    if code != 200 or not text:
        return {"status": "network_error",
                "detail": "PubMed was not reachable" if code is None
                else f"PubMed returned HTTP {code}"}
    try:
        summary = json.loads(text).get("result", {}).get(pmid, {})
    except ValueError:
        return {"status": "network_error", "detail": "PubMed returned an unreadable response"}
    if not summary or summary.get("error"):
        return {"status": "not_found", "detail": f"PMID {pmid} is not in PubMed"}
    return {"meta": _normalize_pubmed_summary(summary)}


def _normalize_openalex_work(work: dict) -> dict:
    title = work.get("display_name") or work.get("title") or ""
    authors = [authorship.get("author", {}).get("display_name", "")
               for authorship in work.get("authorships") or []]
    doi = (work.get("doi") or "").replace("https://doi.org/", "")
    return {"source": "openalex", "title": title, "titles": [title],
            "authors": [author for author in authors if author],
            "year": work.get("publication_year"), "doi": doi, "container": "", "type": ""}


# ------------------------------------------- comparison and classification


def _compare_entry_with_meta(entry: dict, meta: dict) -> dict:
    """An id that resolves is not enough: the metadata the paper prints must be
    what the registry says."""
    title = entry.get("title", "")
    if title and not _titles_match(title, meta.get("titles") or [meta.get("title", "")]):
        return {"status": "title_mismatch",
                "detail": f"the id resolves to '{meta.get('title')}'"
                          " but the entry's title differs"}
    authors_ok, why = _compare_author_lists(entry.get("author", ""), meta.get("authors") or [])
    if not authors_ok:
        return {"status": "author_mismatch", "detail": why}
    year_match = re.search(r"\d{4}", entry.get("year", "") or "")
    if year_match and meta.get("year") and int(year_match.group(0)) != int(meta["year"]):
        return {"status": "year_mismatch",
                "detail": f"the entry says {year_match.group(0)}"
                          f" but the registry says {meta['year']}"}
    return {"status": "verified", "detail": ""}


def _compare_resolution(entry: dict, resolution: dict) -> dict:
    if "meta" in resolution:
        comparison = _compare_entry_with_meta(entry, resolution["meta"])
        comparison["_meta"] = resolution["meta"]
        return comparison
    return resolution


def _pick_matching_candidate(
    entry: dict, title: str, candidate_metas: list[dict], near_miss: dict | None
) -> tuple[dict | None, dict | None]:
    """Compare every title-matching candidate against the entry. Returns
    (accepted_result, near_miss): accepted on a verified or year-skewed match,
    otherwise the first mismatching candidate is kept as the near miss."""
    for meta in candidate_metas:
        if not _titles_match(title, meta["titles"]):
            continue
        comparison = _compare_entry_with_meta(entry, meta)
        comparison["_meta"] = meta
        if comparison["status"] in ("verified", "year_mismatch"):
            return comparison, near_miss
        near_miss = near_miss or comparison
    return None, near_miss


def _search_title(entry: dict) -> dict:
    """Id-less entry: find any real work with a strictly matching title, first in
    Crossref, then in OpenAlex, and compare the full metadata of each candidate.
    Only after both searches come up empty over a working network is the entry
    called unresolved."""
    title = entry.get("title", "")
    reached_any = False
    near_miss = None

    code, text = _open_url(f"{_CROSSREF_API_URL}?rows=5&query.bibliographic="
                           + urllib.parse.quote(title))
    if code == 200 and text:
        try:
            items = json.loads(text).get("message", {}).get("items", [])
        except ValueError:
            items = None
        if items is not None:
            reached_any = True
            accepted, near_miss = _pick_matching_candidate(
                entry, title, [_normalize_crossref_work(item) for item in items], near_miss
            )
            if accepted:
                return accepted
    elif code is not None:
        reached_any = True

    code, text = _open_url(f"{_OPENALEX_API_URL}?per_page=5&search=" + urllib.parse.quote(title))
    if code == 200 and text:
        try:
            works = json.loads(text).get("results", [])
        except ValueError:
            works = None
        if works is not None:
            reached_any = True
            accepted, near_miss = _pick_matching_candidate(
                entry, title, [_normalize_openalex_work(work) for work in works], near_miss
            )
            if accepted:
                return accepted
    elif code is not None:
        reached_any = True

    if near_miss:
        return near_miss
    if not reached_any:
        return {"status": "network_error", "detail": "no search endpoint was reachable"}
    return {"status": "unresolved",
            "detail": "no Crossref or OpenAlex work matches this title"}


def _classify_entry(entry: dict) -> dict:
    """Resolve the entry's registry record and compare field by field. The result
    may carry _meta (the fetched record) for the positive cache. A definitive
    not-found on one id falls through to the next resolvable handle, so a real
    paper is not called fabricated on the strength of one registry's gap."""
    title = entry.get("title", "")
    doi = _extract_doi(entry)
    arxiv_id = _extract_arxiv_id(entry)
    pmid = (entry.get("pmid") or "").strip()
    result = {}
    if doi:
        result = _compare_resolution(entry, _resolve_doi(doi))
        if result.get("status") == "not_found" and (arxiv_id or pmid or title):
            result = {}
    if not result and arxiv_id:
        result = _compare_resolution(entry, _resolve_arxiv_id(arxiv_id))
        if result.get("status") == "not_found" and (pmid or title):
            result = {}
    if not result and pmid:
        result = _compare_resolution(entry, _resolve_pmid(pmid))
        if result.get("status") == "not_found" and title:
            result = {}
    if not result:
        if title:
            result = _search_title(entry)
        else:
            result = {"status": "no_query",
                      "detail": "the entry has no DOI, arXiv id, PMID, or title to verify"}
    return result


# ----------------------------------------------------- the positive cache


def _build_cache_keys(entry: dict) -> list:
    """Identity keys for the positive cache. Only the registry record is cached;
    the field comparison re-runs locally on every check, so an entry edited to
    disagree with its cached record is still caught."""
    keys = []
    doi = _extract_doi(entry)
    if doi:
        keys.append("doi:" + doi.lower())
    arxiv_id = _extract_arxiv_id(entry)
    if arxiv_id:
        keys.append("arxiv:" + arxiv_id.lower())
    normalized_title = _normalize_for_match(entry.get("title", ""))
    if normalized_title:
        keys.append("title:" + normalized_title)
    return keys


def _load_cache(cache_path: Path) -> dict:
    try:
        cache = json.loads(cache_path.read_text(encoding="utf-8"))
    except (FileNotFoundError, json.JSONDecodeError):
        return {}
    return cache if isinstance(cache, dict) else {}


# -------------------------------------------------- rendering (add command)

_TEX_SPECIAL_RE = re.compile(r"(?<!\\)([&%#])")
_KEY_STOP_WORDS = {"a", "an", "the", "on", "of", "for", "and", "or", "in", "to", "with",
                   "when", "at", "from", "by", "is", "are", "as", "its", "their", "via",
                   "toward", "towards", "do", "does", "can", "what", "how", "why"}


def _escape_tex(text: str) -> str:
    return _TEX_SPECIAL_RE.sub(r"\\\1", text or "")


def _make_entry_key(meta: dict) -> str:
    """Stable citation key: first author's family name + year + first significant
    title word. "anon" stands in when no author name survives ASCII folding."""
    name_tokens = _split_name_tokens(meta["authors"][0]) if meta.get("authors") else []
    family = name_tokens[-1] if name_tokens else "anon"
    title_words = re.sub(
        r"[^a-z0-9\s]", " ", _fold_to_ascii(meta.get("title", "")).lower()
    ).split()
    significant = [word for word in title_words if word not in _KEY_STOP_WORDS]
    first_word = significant[0] if significant else (title_words[0] if title_words else "untitled")
    return f"{family}{meta.get('year') or ''}{first_word}"


def _render_bib_entry(key: str, meta: dict) -> str:
    """Render the canonical BibTeX for a registry record. This is the only way a
    bib entry comes into existence; a registry-generated entry cannot carry a
    hallucinated title, author list, or year."""
    authors = _escape_tex(" and ".join(meta.get("authors") or []))
    if meta.get("source") == "arxiv":
        arxiv_id = meta.get("arxiv", "")
        lines = [f"@misc{{{key},",
                 f"  title={{{_escape_tex(meta.get('title', ''))}}},",
                 f"  author={{{authors}}},",
                 f"  year={{{meta.get('year') or ''}}},",
                 f"  eprint={{{arxiv_id}}},",
                 "  archivePrefix={arXiv},"]
        if meta.get("primary_class"):
            lines.append(f"  primaryClass={{{meta['primary_class']}}},")
        lines.append(f"  url={{https://arxiv.org/abs/{arxiv_id}}}")
        lines.append("}")
        return "\n".join(lines)
    entry_type = {"journal-article": "article", "proceedings-article": "inproceedings",
                  "book-chapter": "incollection", "book": "book",
                  "monograph": "book"}.get(meta.get("type", ""), "misc")
    fields = [("title", _escape_tex(meta.get("title", ""))),
              ("author", authors),
              ("year", str(meta.get("year") or ""))]
    container = meta.get("container", "")
    if container and entry_type in ("article", "inproceedings", "incollection"):
        fields.append(("journal" if entry_type == "article" else "booktitle",
                       _escape_tex(container)))
    for field_name in ("volume", "number", "pages"):
        if meta.get(field_name):
            fields.append((field_name, str(meta[field_name])))
    doi = meta.get("doi", "")
    if doi:
        fields.append(("doi", doi))
        fields.append(("url", f"https://doi.org/{doi}"))
    body = ",\n".join(f"  {name}={{{value}}}" for name, value in fields if value)
    return f"@{entry_type}{{{key},\n{body}\n}}"


# ------------------------------------------------------------ the commands


def _read_refs_json_entries(path: Path, text: str) -> list[dict]:
    """Parse a JSON reference list in the o1_citation_existence payload shape:
    [{referenceString, bibliography: {doi, authors, year, title?, arxivId?, pmid?}}].
    ``text`` is the decoded content of ``path``; the path is for messages only."""
    try:
        items = json.loads(text)
    except json.JSONDecodeError as error:
        _exit_with_error(f"The file {path} is not valid JSON. Cause: {error}", 2)
    if not isinstance(items, list) or not all(isinstance(item, dict) for item in items):
        _exit_with_error(f"The file {path} does not hold a JSON array of reference objects.", 2)
    entries = []
    for index, item in enumerate(items, start=1):
        bibliography = item.get("bibliography") or {}
        entry = {
            "key": f"ref-{index}",
            "title": (bibliography.get("title") or "").strip(),
            "author": " and ".join(bibliography.get("authors") or []),
            "year": str(bibliography.get("year") or ""),
            "doi": (bibliography.get("doi") or "").strip(),
            "pmid": str(bibliography.get("pmid") or "").strip(),
        }
        arxiv_id = (bibliography.get("arxivId") or "").strip()
        if arxiv_id:
            entry["eprint"] = arxiv_id
            entry["archiveprefix"] = "arXiv"
        entries.append(entry)
    return entries


def _print_verify_summary(report: dict, out_path: Path) -> None:
    counts = report["counts"]
    print(f"Checked {len(report['entries'])} references: {counts['verified']} verified,"
          f" {counts['blocking']} blocking, {counts['warning']} warnings.")
    for entry in report["entries"]:
        if entry["status"] == "verified":
            continue
        label = "blocking" if entry["status"] in _BLOCKING_STATUSES else "warning"
        print(f"  [{label}] {entry['status']}: {entry['key']}. {entry['detail']}")
    if report["nothing_verified"]:
        print("No reference was verified, so this report does not pass the gate.")
    print(f"The report is in {out_path}.")


def _run_verify(args: argparse.Namespace) -> None:
    source_path = Path(args.refs_json) if args.refs_json else Path(args.bib or _DEFAULT_BIB_PATH)
    # One read serves both the parse and the hash, so the report can never
    # certify bytes that were not the bytes checked.
    try:
        source_bytes = source_path.read_bytes()
    except FileNotFoundError:
        _exit_with_error(f"The file {source_path} does not exist.", 2)
    source_text = source_bytes.decode("utf-8", errors="replace")
    if args.refs_json:
        entries = _read_refs_json_entries(source_path, source_text)
    else:
        entries = _parse_bib(source_text)

    out_path = Path(args.out)
    cache_path = out_path.parent / _CACHE_FILE_NAME
    cache = _load_cache(cache_path)

    report_entries = []
    for entry in entries:
        cache_keys = _build_cache_keys(entry)
        cached_meta = next(
            (cache[key] for key in cache_keys if isinstance(cache.get(key), dict)), None
        )
        if cached_meta is not None:
            result = _compare_entry_with_meta(entry, cached_meta)
        else:
            result = _classify_entry(entry)
            meta = result.pop("_meta", None)
            if meta is not None and result["status"] in ("verified", "year_mismatch"):
                for cache_key in cache_keys:
                    cache[cache_key] = meta
        report_entries.append({
            "key": entry.get("key", ""),
            "doi": _extract_doi(entry),
            "arxiv_id": _extract_arxiv_id(entry),
            "title": entry.get("title", ""),
            "status": result["status"],
            "detail": result.get("detail", ""),
        })

    verified_count = sum(1 for entry in report_entries if entry["status"] == "verified")
    blocking_count = sum(1 for entry in report_entries if entry["status"] in _BLOCKING_STATUSES)
    warning_count = sum(1 for entry in report_entries if entry["status"] in _WARNING_STATUSES)
    nothing_verified = verified_count == 0
    report = {
        "version": 1,
        "bib_sha256": hashlib.sha256(source_bytes).hexdigest(),
        "checked_at": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime()),
        "entries": report_entries,
        "counts": {"verified": verified_count, "blocking": blocking_count,
                   "warning": warning_count},
        "blocking": blocking_count,
        "nothing_verified": nothing_verified,
        "ok": blocking_count == 0 and not nothing_verified,
    }
    out_path.parent.mkdir(parents=True, exist_ok=True)
    out_path.write_text(json.dumps(report, indent=2) + "\n", encoding="utf-8")
    cache_path.write_text(json.dumps(cache, indent=2) + "\n", encoding="utf-8")
    _print_verify_summary(report, out_path)
    if not report["ok"]:
        sys.exit(1)


def _run_add(args: argparse.Namespace) -> None:
    if args.doi:
        resolution = _resolve_doi(args.doi.strip())
        identifier = f"DOI {args.doi}"
    else:
        resolution = _resolve_arxiv_id(re.sub(r"v\d+$", "", args.arxiv_id.strip()))
        identifier = f"arXiv id {args.arxiv_id}"
    if "meta" not in resolution:
        _exit_with_error(f"The client cannot fetch the record for {identifier}:"
                         f" {resolution['detail']}. Make sure that the identifier"
                         " is correct. Then run the command again.")
    meta = resolution["meta"]
    bib_path = Path(args.bib)
    existing_text = (bib_path.read_text(encoding="utf-8", errors="replace")
                     if bib_path.exists() else "")

    # Two different papers can share the generated key (same first author, year,
    # and first title word). Only a matching identifier is a true duplicate;
    # a different paper gets a letter suffix instead of a refusal.
    entries_by_key = {entry.get("key", ""): entry for entry in _parse_bib(existing_text)}
    base_key = _make_entry_key(meta)
    meta_doi = (meta.get("doi") or "").lower()
    meta_arxiv = (meta.get("arxiv") or "").lower()
    for suffix in ("", *string.ascii_lowercase[1:]):
        key = base_key + suffix
        existing_entry = entries_by_key.get(key)
        if existing_entry is None:
            break
        same_doi = meta_doi and _extract_doi(existing_entry).lower() == meta_doi
        same_arxiv = meta_arxiv and _extract_arxiv_id(existing_entry).lower() == meta_arxiv
        if same_doi or same_arxiv:
            _exit_with_error(f"The reference is already in {bib_path} as {key}."
                             " Cite it with that key.")
    else:
        _exit_with_error(f"More than {len(string.ascii_lowercase)} entries in {bib_path}"
                         f" share the key {base_key}. Remove the entries that you"
                         " do not need.")

    rendered_entry = _render_bib_entry(key, meta)
    bib_path.parent.mkdir(parents=True, exist_ok=True)
    with bib_path.open("a", encoding="utf-8") as handle:
        if existing_text and not existing_text.endswith("\n"):
            handle.write("\n")
        if existing_text:
            handle.write("\n")
        handle.write(rendered_entry + "\n")
    print(rendered_entry)
    print(f"\nThe entry {key} is now in {bib_path}.")


_GATE_VERIFY_CMD = "exactory-check verify --bib draft/references.bib"


def _run_gate(args: argparse.Namespace) -> None:
    """Offline check that the citation report passes the submit and deposit gate.
    Exit 0 on pass, 1 on a failed condition, 2 when there is no workspace."""
    if args.workspace:
        workspace = Path(args.workspace)
        if not (workspace / ".exactory" / "draft.json").is_file():
            _exit_with_error(f"The directory {workspace} has no .exactory/draft.json."
                             " Pass the workspace root to --workspace.", 2)
    else:
        start_dir = Path.cwd().resolve()
        workspace = next(
            (directory for directory in (start_dir, *start_dir.parents)
             if (directory / ".exactory" / "draft.json").is_file()),
            None,
        )
        if workspace is None:
            _exit_with_error(f"No directory from {start_dir} upward holds"
                             " .exactory/draft.json. Run the gate from a draft"
                             " workspace, or pass --workspace.", 2)

    references_path = workspace / "draft" / "references.bib"
    if not references_path.is_file():
        _exit_with_error("The workspace has no draft/references.bib. Add each"
                         " reference with: exactory-check add --doi <doi>")
    report_path = workspace / ".exactory" / "citation-check.json"
    try:
        report = json.loads(report_path.read_text(encoding="utf-8"))
    except FileNotFoundError:
        _exit_with_error(f"No citation report exists. Run: {_GATE_VERIFY_CMD}")
    except (OSError, ValueError):
        report = None
    if not isinstance(report, dict):
        _exit_with_error(f"The citation report is not readable. Run: {_GATE_VERIFY_CMD}")
    if report.get("bib_sha256") != hashlib.sha256(references_path.read_bytes()).hexdigest():
        _exit_with_error("The citation report is stale because draft/references.bib"
                         f" changed. Run: {_GATE_VERIFY_CMD}")
    if report.get("blocking") != 0:
        _exit_with_error("The citation report shows blocking references. Correct"
                         f" them. Then run: {_GATE_VERIFY_CMD}")
    if report.get("nothing_verified") is not False:
        _exit_with_error("The citation report verified zero references. Connect to"
                         f" the network. Then run: {_GATE_VERIFY_CMD}")
    print("Citation gate: pass")


def _build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(prog="exactory-check", description=__doc__,
                                     allow_abbrev=False)
    commands = parser.add_subparsers(dest="command", required=True)

    add = commands.add_parser("add", allow_abbrev=False,
                              help="Fetch a registry record and append its BibTeX entry.")
    identifier = add.add_mutually_exclusive_group(required=True)
    identifier.add_argument("--doi", help="A DOI, for example 10.5281/zenodo.21381192.")
    identifier.add_argument("--arxiv-id", help="An arXiv id, for example 2301.00001.")
    add.add_argument("--bib", default=_DEFAULT_BIB_PATH,
                     help=f"Path of the references file (default: {_DEFAULT_BIB_PATH}).")
    add.set_defaults(handler=_run_add)

    verify = commands.add_parser("verify", allow_abbrev=False,
                                 help="Check every reference against the registries.")
    source = verify.add_mutually_exclusive_group()
    source.add_argument("--bib",
                        help=f"Path of the references file (default: {_DEFAULT_BIB_PATH}).")
    source.add_argument("--refs-json",
                        help="Path of a JSON reference list in the o1_citation_existence"
                             " payload shape (the claim format exactory uses for"
                             " citation-existence checks).")
    verify.add_argument("--out", default=_DEFAULT_REPORT_PATH,
                        help=f"Path of the report file (default: {_DEFAULT_REPORT_PATH}).")
    verify.set_defaults(handler=_run_verify)

    gate = commands.add_parser("gate", allow_abbrev=False,
                               help="Check offline that the citation report is fresh"
                                    " and clean.")
    gate.add_argument("--workspace",
                      help="Workspace root (default: the nearest directory, from the"
                           " current one upward, that holds .exactory/draft.json).")
    gate.set_defaults(handler=_run_gate)

    return parser


def main() -> None:
    args = _build_parser().parse_args()
    args.handler(args)


if __name__ == "__main__":
    main()
