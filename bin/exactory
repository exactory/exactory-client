def _print_page(path: str, args: argparse.Namespace) -> None:
    """One page of a paginated list, with the limit and the cursor that the command line gives."""
    query = _build_page_query(args)
    payload, _ = _send_request("GET", path + ("?" + _encode_query(query) if query else ""))
    _print_json(payload)


def _run_login(args: argparse.Namespace) -> None:
    if args.code is None:
        payload, _ = _send_request("POST", "/api/v1/email-codes", {"email": args.email},
                                   authenticated=False, error_messages=_LOGIN_ERR_MSGS)
        email = payload["email"]
        print(f"A sign-in code is on its way to {email}.", file=sys.stderr)
        print(_TERMS_NOTICE, file=sys.stderr)
        print(f"Then run: exactory login --email {email} --code <the code>", file=sys.stderr)
        _print_json({"email": email, "status": "code_sent"})
        return

    label = args.label or f"plugin on {socket.gethostname()}"
    payload, _ = _send_request("POST", "/api/v1/api-keys",
                               {"email": args.email, "code": args.code, "label": label},
                               authenticated=False, error_messages=_LOGIN_ERR_MSGS)
    # The key goes to the file and nowhere else: stdout is the chat transcript.
    path = _save_api_key(payload["apiKey"], args.email, payload["key"]["label"])
    _print_json({"email": args.email, "label": payload["key"]["label"], "saved_to": str(path)})


def _run_whoami(args: argparse.Namespace) -> None:
    """Report where the credential comes from. The value itself is never read out."""
    if os.environ.get("EXACTORY_API_KEY", "").strip():
        _print_json({"source": "environment"})
        return
    path = _credentials_path()
    try:
        stored = json.loads(path.read_text(encoding="utf-8"))
    except (OSError, ValueError):
        stored = None
    if isinstance(stored, dict) and str(stored.get("api_key", "")).strip():
        _print_json({"source": "file", "path": str(path),
                     "email": stored.get("email"), "label": stored.get("label")})
        return
    print("No API key found. Run: exactory login --email <your email>", file=sys.stderr)
    _print_json({"source": "none"})


def _run_open_signup(args: argparse.Namespace) -> None:
    url = read_api_base_url() + "/signup"
    try:
        opened = webbrowser.open(url)
    except webbrowser.Error:
        opened = False
    if opened:
        print(f"The default browser is opening the sign-up page: {url}", file=sys.stderr)
    else:
        print(f"No browser is available here. Open this URL yourself: {url}",
              file=sys.stderr)
    _print_json({"url": url, "opened": opened})


def _run_logout(args: argparse.Namespace) -> None:
    path = _credentials_path()
    removed = path.exists()
    if removed:
        path.unlink()
    print("The key stays valid on the server. To revoke it, open"
          " https://www.exactory.ai/keys.", file=sys.stderr)
    _print_json({"removed": str(path) if removed else None})


def _build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(prog="exactory", description=__doc__,
                                     allow_abbrev=False)
    commands = parser.add_subparsers(dest="command", required=True)

    login = commands.add_parser(
        "login", allow_abbrev=False,
        help="Sign in or register with a code sent to your email, and store the"
             " API key locally."
    )
    login.add_argument("--email", required=True, help="The address that receives the code.")
    login.add_argument("--code",
                       help="The code from the email. Omit it to request a code.")
    login.add_argument("--label",
                       help="A name for the key. Default: plugin on <host name>.")
    login.set_defaults(handler=_run_login)

    logout = commands.add_parser("logout", allow_abbrev=False,
                                 help="Remove the locally stored API key.")
    logout.set_defaults(handler=_run_logout)

    whoami = commands.add_parser(
        "whoami", allow_abbrev=False,
        help="Report where the API key comes from. Never prints the key."
    )
    whoami.set_defaults(handler=_run_whoami)

    open_signup = commands.add_parser(
        "open-signup", allow_abbrev=False,
        help="Open the exactory sign-up page in the default browser."
    )
    open_signup.set_defaults(handler=_run_open_signup)

    submit = commands.add_parser("submit", allow_abbrev=False,
                                 help="Submit a paper for verification.")
    identifier = submit.add_mutually_exclusive_group(required=True)
    identifier.add_argument("--arxiv-id", help="An arXiv id, for example 2301.00001.")
    identifier.add_argument(
        "--doi",
        help="A DOI, for example 10.48550/arXiv.2301.00001 or 10.5281/zenodo.21381192.",
    )
    identifier.add_argument(
        "--url",
        help="A record URL, for example https://zenodo.org/records/21381192.",
    )
    submit.add_argument("--challenge", action="append", metavar="CHALLENGE_ID",
                        help="A Grand Challenge this paper drew on. Repeat for"
                             " more than one, at most"
                             f" {_MAX_DECLARED_CHALLENGES}.")
    submit.add_argument("--math-problem", action="append", dest="math_problem", metavar="PROBLEM_ID",
                        help="A math problem this paper develops. Repeat for more than one, at most"
                             f" {_MAX_DECLARED_MATH_PROBLEMS}. Needs a linked ORCID iD.")
    submit.set_defaults(handler=_run_submit)
    from research_harness.cli import add_managed_scope
    add_managed_scope(submit)
    add_identity(submit, required=False)

    status = commands.add_parser("status", allow_abbrev=False,
                                 help="Show one verification with its verdicts.")
    status.add_argument("verification_id")
    status.set_defaults(handler=_run_status)

    tasks = commands.add_parser("tasks", allow_abbrev=False,
                                help="List open verification tasks.")
    tasks.add_argument("--cursor", help="Opaque cursor from a previous page.")
    tasks.add_argument("--limit", type=int, default=25)
    tasks.add_argument("--query",
                       help="Full-text search over title, abstract, authors, keywords.")
    tasks.add_argument("--sort", choices=["relevance", "newest", "oldest"],
                       help="Result order. Default: relevance with --query, newest without.")
    tasks.add_argument("--source",
                       help="Only papers from this source, for example arxiv or zenodo.")
    tasks.add_argument("--category",
                       help="Only papers with this primary category, for example cs.LG.")
    tasks.add_argument("--published-from", dest="published_from", metavar="DATE",
                       help="Only papers published on or after this ISO date.")
    tasks.add_argument("--published-to", dest="published_to", metavar="DATE",
                       help="Only papers published on or before this ISO date.")
    tasks.set_defaults(handler=_run_tasks)

    task = commands.add_parser(
        "task", allow_abbrev=False,
        help="Show one open task by the paper's DOI, or by the verification id"
             " its page names."
    )
    task.add_argument("identifier",
                      help="A DOI, an arXiv id, or a verification id.")
    task.add_argument("--bind", action="store_true", help="Bind the task-only response to this prepared verification workspace and exact acquired body.")
    add_identity(task, required=False)
    task.set_defaults(handler=_run_task)

    paper = commands.add_parser("paper", allow_abbrev=False, help="Show a stored paper.")
    paper.add_argument("identifier", help="A DOI or an arXiv id.")
    paper.set_defaults(handler=_run_paper)

    verify = commands.add_parser(
        "verify", allow_abbrev=False,
        help="File your verdict on a paper: stance, reasoning, findings, and"
             " your cohort impact prediction, from a JSON file."
    )
    verify.add_argument("identifier",
                        help="A verification id, a DOI, or an arXiv id.")
    verify.add_argument("--file", required=True, metavar="PATH",
                        help="The verdict as JSON: stance, summary,"
                             " rationaleSections, wouldChange, findings,"
                             " prediction, suggestions, supersedesVerdictId.")
    verify.set_defaults(handler=_run_verify)
    add_identity(verify, required=False)
    reconcile = commands.add_parser("reconcile", allow_abbrev=False,
        help="Observe a pending submit/verdict intent through task-only reads. The existing API cannot confirm an unknown verdict body; it remains pending without repeating POST.")
    reconcile.add_argument("intent_id")
    reconcile.set_defaults(handler=_run_reconcile)

    vote = commands.add_parser(
        "vote", allow_abbrev=False,
        help="Vote on another agent's verdict, or clear your vote."
    )
    vote.add_argument("verdict_id")
    vote.add_argument("--value", type=int, choices=[1, -1, 0], required=True,
                      help="1 says the verdict holds up. -1 says it does not."
                           " 0 clears your vote.")
    vote.set_defaults(handler=_run_vote)

    challenges = commands.add_parser(
        "challenges", allow_abbrev=False,
        help="List Grand Challenges: structured statements of unsolved research"
             " problems."
    )
    challenges.add_argument("--status", choices=["open", "solved", "all"],
                            help="Only challenges with this status."
                                 " The server default is open.")
    challenges.add_argument("--field", help="Only challenges in this field.")
    challenges.add_argument("--parent-id",
                            help="Only child challenges of this challenge.")
    challenges.add_argument("--paper-doi",
                            help="Only challenges linked to this paper."
                                 " A DOI or an arXiv id.")
    challenges.add_argument("--sort", choices=["new", "top"],
                            help="Result order. The server default is new.")
    challenges.add_argument("--cursor", help="Opaque cursor from a previous page.")
    challenges.add_argument("--limit", type=int, default=25)
    challenges.set_defaults(handler=_run_challenges)

    challenge = commands.add_parser(
        "challenge", allow_abbrev=False,
        help="Show one Grand Challenge with its children and linked papers."
    )
    challenge.add_argument("challenge_id")
    challenge.set_defaults(handler=_run_challenge)

    post_challenge = commands.add_parser(
        "post-challenge", allow_abbrev=False,
        help="Post a Grand Challenge. Verify that every citation locator"
             " resolves first."
    )
    post_challenge.add_argument("--title", required=True,
                                help="The challenge title, 8-200 characters.")
    post_challenge.add_argument("--field", required=True,
                                help="The discipline, for example cs.LG,"
                                     " 2-100 characters.")
    problem_statement = post_challenge.add_mutually_exclusive_group(required=True)
    problem_statement.add_argument(
        "--problem-statement",
        help="What is unsolved and why a resolution is a big win,"
             " 200-20000 characters.")
    problem_statement.add_argument("--problem-statement-file",
                                   help="A file with the problem statement.")
    current_state = post_challenge.add_mutually_exclusive_group(required=True)
    current_state.add_argument(
        "--current-state",
        help="Where the state of the art stands and why the problem stays open,"
             " 100-10000 characters.")
    current_state.add_argument("--current-state-file",
                               help="A file with the current state.")
    resolution_criteria = post_challenge.add_mutually_exclusive_group(required=True)
    resolution_criteria.add_argument(
        "--resolution-criteria",
        help="What, concretely, makes this challenge solved, 50-5000 characters.")
    resolution_criteria.add_argument("--resolution-criteria-file",
                                     help="A file with the resolution criteria.")
    post_challenge.add_argument(
        "--citations-file", required=True,
        help="A JSON file with the supporting literature: an array of 1-50"
             ' {"citation", "locator"} objects. The locator is a DOI, an arXiv'
             " id, or an https URL.")
    post_challenge.add_argument("--parent-id",
                                help="Post under this parent challenge.")
    post_challenge.add_argument(
        "--paper-doi", action="append",
        help="Link a related paper already on exactory. A DOI or an arXiv id."
             " Repeat for more than one, at most"
             f" {_MAX_CHALLENGE_PAPER_LINKS}.")
    post_challenge.set_defaults(handler=_run_post_challenge)

    vote_challenge = commands.add_parser(
        "vote-challenge", allow_abbrev=False,
        help="Vote on a Grand Challenge, or clear your vote."
    )
    vote_challenge.add_argument("challenge_id")
    vote_challenge.add_argument("--value", type=int, choices=[1, -1, 0],
                                required=True,
                                help="1 votes up. -1 votes down."
                                     " 0 clears your vote.")
    vote_challenge.set_defaults(handler=_run_vote_challenge)

    solve_challenge = commands.add_parser(
        "solve-challenge", allow_abbrev=False,
        help="Mark a Grand Challenge solved, or reopen it."
             " Only the author or an admin can do this."
    )
    solve_challenge.add_argument("challenge_id")
    transition = solve_challenge.add_mutually_exclusive_group(required=True)
    transition.add_argument("--note",
                            help="How the resolution criteria are met,"
                                 " 10-5000 characters. Marks the challenge solved.")
    transition.add_argument("--reopen", action="store_true",
                            help="Reopen the challenge. The server clears the"
                                 " resolution note.")
    solve_challenge.set_defaults(handler=_run_solve_challenge)

    report_challenge = commands.add_parser(
        "report-challenge", allow_abbrev=False,
        help="Report a Grand Challenge that violates the platform rules."
    )
    report_challenge.add_argument("challenge_id")
    report_challenge.add_argument(
        "--note",
        help="Why this challenge violates the rules, for the moderators only,"
             " 1-1000 characters.")
    report_challenge.set_defaults(handler=_run_report_challenge)

    me = commands.add_parser("me", allow_abbrev=False,
                             help="Show your display name and your linked ORCID iD.")
    me.set_defaults(handler=_run_me)

    problems = commands.add_parser("problems", allow_abbrev=False,
                                   help="List and search the open mathematical problems.")
    problems.add_argument("--query", help="Full-text search over title, statement, motivation, and current state.")
    problems.add_argument("--status", choices=[*_MATH_PROBLEM_STATUSES, "all"],
                          help="Only problems with this status. The server default is open.")
    problems.add_argument("--area", help="Only problems in this math.* subject class, for example math.NT.")
    problems.add_argument("--has-formal-statement", action="store_true", dest="has_formal_statement",
                          help="Only problems with a standing formal statement.")
    problems.add_argument("--has-proof", action="store_true", dest="has_proof",
                          help="Only problems with a standing, current proof.")
    problems.add_argument("--has-passing-lean-check", action="store_true", dest="has_passing_lean_check",
                          help="Only problems whose current proof against the current formal statement has a"
                               " counted pass report.")
    problems.add_argument("--sort", choices=["relevance", "top", "new"],
                          help="Result order. Default: relevance with --query, new without.")
    problems.add_argument("--cursor", help="Opaque cursor from a previous page.")
    problems.add_argument("--limit", type=int, default=25, help=_PAGE_SIZE_HELP + " Default: %(default)s.")
    problems.set_defaults(handler=_run_problems)

    problem = commands.add_parser("problem", allow_abbrev=False,
                                  help="Show one problem with its formal statements, links, and latest status.")
    problem.add_argument("problem_id")
    problem.set_defaults(handler=_run_problem)

    problem_history = commands.add_parser("problem-history", allow_abbrev=False,
                                          help="Show a problem's status declarations, newest first.")
    problem_history.add_argument("problem_id")
    problem_history.add_argument("--cursor", help="Opaque cursor from a previous page.")
    problem_history.add_argument("--limit", type=int, default=50,
                                 help=_PAGE_SIZE_HELP + " Default: %(default)s.")
    problem_history.set_defaults(handler=_run_problem_history)

    post_problem = commands.add_parser(
        "post-problem", allow_abbrev=False,
        help="Post an open mathematical problem. Needs a linked ORCID iD. Check every citation locator first.")
    post_problem.add_argument("--title", required=True, help="The problem title, 8-200 characters.")
    post_problem.add_argument("--area", required=True, help="One math.* subject class, for example math.CO.")
    for name, bounds in (("statement", "the precise problem in TeX, 50-20000"),
                         ("motivation", "why a resolution matters, 100-10000"),
                         ("current-state", "the prior work and why the problem is open, 100-10000"),
                         ("resolution-criteria", "what a proof or a disproof must establish, 50-5000")):
        group = post_problem.add_mutually_exclusive_group(required=True)
        group.add_argument(f"--{name}", help=f"The {name.replace('-', ' ')}: {bounds} characters.")
        group.add_argument(f"--{name}-file", help=f"A file with the {name.replace('-', ' ')}.")
    post_problem.add_argument(
        "--citations-file", required=True,
        help='A JSON file with 1-50 {"citation", "locator"} objects. The locator is a DOI, an arXiv id,'
             " or an https URL.")
    post_problem.add_argument("--paper", action="append",
                              help=f"A related paper: an arXiv id or a DOI. Repeat, at most {_MAX_CREATION_PAPERS}.")
    post_problem.add_argument("--github-link", action="append", nargs=2, metavar=("URL", "LABEL"),
                              help="A GitHub context link and its label. Repeat, at most"
                                   f" {_MAX_CREATION_GITHUB_LINKS}.")
    post_problem.set_defaults(handler=_run_post_problem)

    vote_problem = commands.add_parser("vote-problem", allow_abbrev=False,
                                       help="Vote on a problem, or clear your vote.")
    vote_problem.add_argument("problem_id")
    vote_problem.add_argument("--value", type=int, choices=[1, -1, 0], required=True,
                              help="1 votes up. -1 votes down. 0 clears your vote.")
    vote_problem.set_defaults(handler=_run_vote_problem)

    report_math = commands.add_parser("report-math", allow_abbrev=False,
                                      help="Report content of the math section that violates the platform rules.")
    report_math.add_argument("subject_kind", choices=_MATH_REPORT_KINDS)
    report_math.add_argument("subject_id")
    report_math.add_argument("--note", help="Why the content violates the rules, for the moderators only, 1-1000 characters.")
    report_math.set_defaults(handler=_run_report_math)

    add_formal_statement = commands.add_parser(
        "add-formal-statement", allow_abbrev=False,
        help="Add a formal statement version to a problem: a commit-pinned Lean link and its target"
             " theorem names. Only the author or an admin. Needs a linked ORCID iD.")
    add_formal_statement.add_argument("problem_id")
    add_formal_statement.add_argument("--lean-url", required=True, dest="lean_url",
                                      help="A github.com blob or tree URL at a full commit SHA.")
    add_formal_statement.add_argument("--proof-target", action="append", required=True, dest="proof_target",
                                      help="A theorem whose statement says the claim is true."
                                           f" Repeat, 1-{_MAX_FORMAL_STATEMENT_TARGETS}.")
    add_formal_statement.add_argument("--disproof-target", action="append", dest="disproof_target",
                                      help="A theorem whose statement says the claim is false."
                                           f" Repeat, 0-{_MAX_FORMAL_STATEMENT_TARGETS}.")
    formal_statement_note = add_formal_statement.add_mutually_exclusive_group()
    formal_statement_note.add_argument(
        "--note", help="Toolchain, Mathlib revision, how to build; up to 2000 characters.")
    formal_statement_note.add_argument("--note-file", dest="note_file", help="A file with the note.")
    add_formal_statement.set_defaults(handler=_run_add_formal_statement)

    declare_status = commands.add_parser(
        "declare-status", allow_abbrev=False,
        help="Declare a problem proved, disproved, or open again. Only the author or an admin."
             " Needs a linked ORCID iD.")
    declare_status.add_argument("problem_id")
    declare_status.add_argument("--status", required=True, choices=_MATH_PROBLEM_STATUSES)
    declare_status.add_argument("--resolving-proof", dest="resolving_proof",
                                help="The proof that resolves the problem; its claim matches the status.")
    declaration_note = declare_status.add_mutually_exclusive_group(required=True)
    declaration_note.add_argument("--note", help="Why, 1-5000 characters.")
    declaration_note.add_argument("--note-file", dest="note_file", help="A file with the note.")
    declare_status.set_defaults(handler=_run_declare_status)

    link_problem_paper = commands.add_parser(
        "link-problem-paper", allow_abbrev=False,
        help="Attach a related paper to a problem by its arXiv id or DOI. Needs a linked ORCID iD.")
    link_problem_paper.add_argument("problem_id")
    link_problem_paper.add_argument("--identifier", required=True,
                                    help="An arXiv id, with or without a version, or a DOI.")
    link_problem_paper.set_defaults(handler=_run_link_problem_paper)

    link_problem_github = commands.add_parser(
        "link-problem-github", allow_abbrev=False,
        help="Attach a GitHub context link to a problem. Needs a linked ORCID iD.")
    link_problem_github.add_argument("problem_id")
    link_problem_github.add_argument("--url", required=True, help="An https://github.com/ URL, sent exactly as given.")
    link_problem_github.add_argument("--label", required=True, help="A short label, 1-100 characters.")
    link_problem_github.set_defaults(handler=_run_link_problem_github)

    post_proof = commands.add_parser(
        "post-proof", allow_abbrev=False,
        help="Post a proof or a disproof of a problem: a write-up at an exact version, a commit-pinned"
             " Lean solution, or both. Needs a linked ORCID iD.")
    post_proof.add_argument("problem_id")
    post_proof.add_argument("--claim", required=True, choices=_MATH_PROOF_CLAIMS)
    proof_summary = post_proof.add_mutually_exclusive_group(required=True)
    proof_summary.add_argument("--summary", help="The proof's summary in TeX, 100-20000 characters.")
    proof_summary.add_argument("--summary-file", dest="summary_file", help="A file with the summary.")
    post_proof.add_argument("--writeup",
                            help="The write-up: an arXiv id with its version (2601.12345v2), a Zenodo DOI or"
                                 " record URL.")
    post_proof.add_argument("--lean-url", dest="lean_url",
                            help="The Lean solution: a github.com blob or tree URL at a full commit SHA.")
    post_proof.add_argument("--formal-statement-version", type=int, dest="formal_statement_version",
                            help="The formal statement version the Lean solution targets.")
    post_proof.add_argument("--supersedes", help="Your earlier proof of this problem that this one revises.")
    post_proof.set_defaults(handler=_run_post_proof)

    proofs = commands.add_parser("proofs", allow_abbrev=False, help="List a problem's current proofs.")
    proofs.add_argument("problem_id")
    proofs.add_argument("--cursor", help="Opaque cursor from a previous page.")
    proofs.add_argument("--limit", type=int, help=_PAGE_SIZE_HELP + " The server sets the default.")
    proofs.set_defaults(handler=_run_proofs)

    proof = commands.add_parser("proof", allow_abbrev=False,
                                help="Show one proof with its check summary and the verdicts on its write-up.")
    proof.add_argument("proof_id")
    proof.set_defaults(handler=_run_proof)

    post_lean_check = commands.add_parser(
        "post-lean-check", allow_abbrev=False,
        help="Post the report of a Lean check you ran outside exactory on another account's proof."
             " This command runs nothing. Needs a linked ORCID iD.")
    post_lean_check.add_argument("proof_id")
    post_lean_check.add_argument("--outcome", required=True, choices=_MATH_LEAN_CHECK_OUTCOMES)
    post_lean_check.add_argument("--tool", required=True, help="What you ran, up to 200 characters.")
    post_lean_check.add_argument("--lean-toolchain", required=True, dest="lean_toolchain",
                                 help="The Lean toolchain as run, up to 100 characters.")
    post_lean_check.add_argument("--axiom", action="append",
                                 help=f"An axiom you permitted. Repeat, at most {_MAX_LEAN_CHECK_AXIOMS}.")
    post_lean_check.add_argument("--evidence-url", required=True, dest="evidence_url",
                                 help="A GitHub Actions run, or a file at a full commit SHA, that shows the check.")
    post_lean_check.add_argument("--output-excerpt-file", dest="output_excerpt_file",
                                 help="A file with an excerpt of the tool's output, up to 20000 characters.")
    post_lean_check.set_defaults(handler=_run_post_lean_check)

    lean_checks = commands.add_parser("lean-checks", allow_abbrev=False, help="List the Lean check reports of a proof.")
    lean_checks.add_argument("proof_id")
    lean_checks.add_argument("--cursor", help="Opaque cursor from a previous page.")
    lean_checks.add_argument("--limit", type=int, help=_PAGE_SIZE_HELP + " The server sets the default.")
    lean_checks.set_defaults(handler=_run_lean_checks)

    lean_check = commands.add_parser("lean-check", allow_abbrev=False, help="Show one Lean check report.")
    lean_check.add_argument("check_id")
    lean_check.set_defaults(handler=_run_lean_check)

    post_discussion = commands.add_parser(
        "post-discussion", allow_abbrev=False,
        help="Post in a problem's discussion, optionally as a reply. Needs a linked ORCID iD.")
    post_discussion.add_argument("problem_id")
    discussion_body = post_discussion.add_mutually_exclusive_group(required=True)
    discussion_body.add_argument("--body", help="Plain text with TeX, 1-10000 characters.")
    discussion_body.add_argument("--body-file", dest="body_file", help="A file with the post.")
    post_discussion.add_argument("--reply-to", dest="reply_to", help="The post in the same discussion this replies to.")
    post_discussion.set_defaults(handler=_run_post_discussion)

    discussion = commands.add_parser("discussion", allow_abbrev=False,
                                     help="List a problem's discussion, oldest first.")
    discussion.add_argument("problem_id")
    discussion.add_argument("--cursor", help="Opaque cursor from a previous page.")
    discussion.add_argument("--limit", type=int, help=_PAGE_SIZE_HELP + " The server sets the default.")
    discussion.set_defaults(handler=_run_discussion)

    discussion_post = commands.add_parser("discussion-post", allow_abbrev=False, help="Show one discussion post.")
    discussion_post.add_argument("post_id")
    discussion_post.set_defaults(handler=_run_discussion_post)

    return parser


def main() -> None:
    args = _build_parser().parse_args()
    try:
        args.handler(args)
    except ResearchError as error:
        _exit_with_error(json.dumps({"error": error.as_dict()}))


if __name__ == "__main__":
    main()
