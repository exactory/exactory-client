                 "The server returned the existing report for this content.")


def _run_add_formal_statement(args: argparse.Namespace) -> None:
    disproof_targets = args.disproof_target or []
    for target_kind, targets in (("proof", args.proof_target), ("disproof", disproof_targets)):
        _require_at_most(targets, f"{target_kind} targets", _MAX_FORMAL_STATEMENT_TARGETS)
    body = {"leanUrl": _require_lean_source_url(args.lean_url), "proofTargets": args.proof_target,
            "disproofTargets": disproof_targets}
    if args.note is not None or args.note_file is not None:
        body["note"] = _require_utf16_bounds("note", _read_inline_or_file_text(args.note, args.note_file), 0, 2000)
    _send_math_write("POST", _build_api_path("math-problems", args.problem_id, "formal-statements"), body)


def _run_declare_status(args: argparse.Namespace) -> None:
    is_resolution = args.status != "open"
    if is_resolution and not args.resolving_proof:
        _exit_with_error("A proved or disproved declaration names its resolving proof."
                         " Add --resolving-proof <proof-id>.")
    if not is_resolution and args.resolving_proof is not None:
        _exit_with_error("An open declaration names no resolving proof. Remove --resolving-proof.")
    body = {"status": args.status}
    if is_resolution:
        body["resolvingProofId"] = args.resolving_proof
    body["note"] = _require_utf16_bounds("note", _read_inline_or_file_text(args.note, args.note_file), 1, 5000)
    _send_math_write("PATCH", _build_api_path("math-problems", args.problem_id), body)


def _run_link_problem_paper(args: argparse.Namespace) -> None:
    _send_math_write("POST", _build_api_path("math-problems", args.problem_id, "papers"),
                     {"identifier": args.identifier})


def _run_link_problem_github(args: argparse.Namespace) -> None:
    body = {"url": _require_github_context_url(args.url), "label": _require_utf16_bounds("label", args.label, 1, 100)}
    _send_math_write("POST", _build_api_path("math-problems", args.problem_id, "github-links"), body)


# An arXiv id without a version, written as a bare id, an arxiv.org abs URL, or an arXiv DOI. The
# server refuses it as a write-up, because the arXiv resolver cannot find which version is meant
# (design 2026-10-12 §6). The server stays the authority for every other form.
_ARXIV_WITHOUT_VERSION_RE = re.compile(
    r"(?:https?://(?:www\.)?arxiv\.org/abs/|10\.48550/arxiv\.)?"
    r"(?:[0-9]{4}\.[0-9]{4,5}|[a-z-]+(?:\.[a-z]{2})?/[0-9]{7})",
    re.IGNORECASE)


def _run_post_proof(args: argparse.Namespace) -> None:
    summary = _require_utf16_bounds("summary", _read_inline_or_file_text(args.summary, args.summary_file), 100, 20000)
    if args.writeup is None and args.lean_url is None:
        _exit_with_error("A proof carries a write-up, a Lean solution, or both. Add --writeup, or --lean-url with"
                         " --formal-statement-version.")
    if (args.lean_url is None) != (args.formal_statement_version is None):
        _exit_with_error("A Lean solution names the formal statement version it targets. Give --lean-url and"
                         " --formal-statement-version together.")
    body = {"claim": args.claim, "summary": summary}
    if args.writeup is not None:
        writeup = args.writeup.strip()
        if _ARXIV_WITHOUT_VERSION_RE.fullmatch(writeup):
            _exit_with_error(f"The write-up {writeup} is an arXiv id without a version. Name the exact version,"
                             f" for example {writeup}v2.")
        body["writeup"] = writeup
    if args.lean_url is not None:
        body["lean"] = {"url": _require_lean_source_url(args.lean_url),
                        "formalStatementVersion": args.formal_statement_version}
    if args.supersedes is not None:
        body["supersedesProofId"] = args.supersedes
    _send_math_write("POST", _build_api_path("math-problems", args.problem_id, "proofs"), body)


def _run_proofs(args: argparse.Namespace) -> None:
    _print_page(_build_api_path("math-problems", args.problem_id, "proofs"), args)


def _run_proof(args: argparse.Namespace) -> None:
    payload, _ = _send_request("GET", _build_api_path("math-proofs", args.proof_id))
    _print_json(payload)


def _run_post_lean_check(args: argparse.Namespace) -> None:
    """Posts the report of a check run outside exactory. Nothing runs here (design 2026-10-12 §7)."""
    evidence_url = _require_check_evidence_url(args.evidence_url)
    axioms = args.axiom or []
    _require_at_most(axioms, "axioms", _MAX_LEAN_CHECK_AXIOMS)
    body = {
        "outcome": args.outcome,
        "tool": _require_utf16_bounds("tool", args.tool, 1, 200),
        "leanToolchain": _require_utf16_bounds("Lean toolchain", args.lean_toolchain, 1, 100),
        "axioms": axioms,
        "evidenceUrl": evidence_url,
    }
    if args.output_excerpt_file is not None:
        body["outputExcerpt"] = _require_utf16_bounds(
            "output excerpt", _read_inline_or_file_text(None, args.output_excerpt_file), 1, 20000)
    _send_math_write("POST", _build_api_path("math-proofs", args.proof_id, "lean-checks"), body)


