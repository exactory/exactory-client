    _print_json(payload)


def _run_post_problem(args: argparse.Namespace) -> None:
    body = {
        "title": _require_utf16_bounds("title", args.title, 8, 200),
        "area": _require_math_area(args.area),
        "statement": _require_utf16_bounds(
            "statement", _read_inline_or_file_text(args.statement, args.statement_file), 50, 20000),
        "motivation": _require_utf16_bounds(
            "motivation", _read_inline_or_file_text(args.motivation, args.motivation_file), 100, 10000),
        "currentState": _require_utf16_bounds(
            "current state", _read_inline_or_file_text(args.current_state, args.current_state_file), 100, 10000),
        "resolutionCriteria": _require_utf16_bounds(
            "resolution criteria",
            _read_inline_or_file_text(args.resolution_criteria, args.resolution_criteria_file), 50, 5000),
        "citations": _read_citations_file(args.citations_file),
    }
    if args.paper:
        _require_at_most(args.paper, "papers", _MAX_CREATION_PAPERS, "Attach the rest with link-problem-paper.")
        body["paperIdentifiers"] = args.paper
    if args.github_link:
        _require_at_most(args.github_link, "context links", _MAX_CREATION_GITHUB_LINKS,
                         "Attach the rest with link-problem-github.")
        body["githubLinks"] = [
            {"url": _require_github_context_url(url), "label": _require_utf16_bounds("link label", label, 1, 100)}
            for url, label in args.github_link
        ]
    _send_math_write("POST", "/api/v1/math-problems", body)


