def _run_problems(args: argparse.Namespace) -> None:
    query = _build_page_query(args)
    for key, value in (("q", args.query), ("status", args.status), ("area", args.area), ("sort", args.sort)):
        if value:
            query[key] = value
    for key, enabled in (("hasFormalStatement", args.has_formal_statement), ("hasProof", args.has_proof),
                         ("hasPassingLeanCheck", args.has_passing_lean_check)):
        if enabled:
            query[key] = "true"
    payload, _ = _send_request("GET", "/api/v1/math-problems?" + _encode_query(query))
    _print_json(payload)


