{
  "description": "Managed Codex hooks. Generated by codex/generate.py.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "exec @PYTHON@ -I -B @DISPATCHER@ PreToolUse hook.py guard_attack_files.py",
            "timeout": 30
          }
        ]
      },
      {
        "matcher": "Bash|exec_command",
        "hooks": [
          {
            "type": "command",
            "command": "exec @PYTHON@ -I -B @DISPATCHER@ PreToolUse hook.py guard_experiment_exec.py",
            "timeout": 15
          },
          {
            "type": "command",
            "command": "exec @PYTHON@ -I -B @DISPATCHER@ PreToolUse hook.py enforce_decision_log.py",
            "timeout": 15
          }
        ]
      },
      {
        "matcher": "Write|Edit|apply_patch",
        "hooks": [
          {
            "type": "command",
            "command": "exec @PYTHON@ -I -B @DISPATCHER@ PreToolUse hook.py enforce_unit_flow.py",
            "timeout": 15
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|apply_patch",
        "hooks": [
          {
            "type": "command",
            "command": "exec @PYTHON@ -I -B @DISPATCHER@ PostToolUse hook.py check_references_edit.py",
            "timeout": 15
          }
        ]
      },
      {
        "matcher": "Write|apply_patch",
        "hooks": [
          {
            "type": "command",
            "command": "exec @PYTHON@ -I -B @DISPATCHER@ PostToolUse hook.py record_paper_authorship.py",
            "timeout": 15
          }
        ]
      },
      {
        "matcher": "Write|Edit|Bash|exec_command|apply_patch",
        "hooks": [
          {
            "type": "command",
            "command": "exec @PYTHON@ -I -B @DISPATCHER@ PostToolUse hook.py record_attack_activity.py",
            "timeout": 15
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "exec @PYTHON@ -I -B @DISPATCHER@ SessionStart session_start.py",
            "timeout": 10
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "exec @PYTHON@ -I -B @DISPATCHER@ SessionStart hook.py resume_attack.py",
            "timeout": 30
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "exec @PYTHON@ -I -B @DISPATCHER@ Stop hook.py continue_autopilot.py",
            "timeout": 30
          },
          {
            "type": "command",
            "command": "exec @PYTHON@ -I -B @DISPATCHER@ Stop hook.py continue_attack.py",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
