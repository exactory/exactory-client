#!/bin/sh
# Fake lake for the harness tests. Behaviour comes from the environment:
#   FAKE_LAKE_LOG          file that receives "$PWD $*" per call, then the checked file
#   FAKE_LAKE_BUILD_STATUS exit status of `lake build` (default 0)
#   FAKE_LAKE_LEAN_STATUS  exit status of `lake env lean <file>` (default 0)
#   FAKE_LAKE_AXIOMS       comma-separated axioms to report; empty reports none
echo "$PWD $*" >> "$FAKE_LAKE_LOG"
case "$1" in
  build)
    echo "Build completed successfully."
    exit "${FAKE_LAKE_BUILD_STATUS:-0}"
    ;;
  env)
    cat "$3" >> "$FAKE_LAKE_LOG"
    if [ "${FAKE_LAKE_LEAN_STATUS:-0}" != 0 ]; then
      echo "$3:1:0: error: unknown identifier"
      exit "$FAKE_LAKE_LEAN_STATUS"
    fi
    name=$(sed -n 's/^#check @//p' "$3")
    echo EXACTORY_TYPE_BEGIN
    echo "$name : ${FAKE_LAKE_PRINTED_TYPE:-True}"
    echo EXACTORY_TYPE_END
    if [ -z "$FAKE_LAKE_AXIOMS" ]; then
      echo "'$name' does not depend on any axioms"
    else
      echo "'$name' depends on axioms: [$FAKE_LAKE_AXIOMS]"
    fi
    echo "'exactory_correspondence' depends on axioms: [${FAKE_LAKE_CORRESPONDENCE_AXIOMS:-$FAKE_LAKE_AXIOMS}]"
    ;;
esac
