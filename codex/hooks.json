{
  "description": "Codex adapter for the shared Exactory hooks. Generated by codex/generate.py.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${PLUGIN_ROOT}/codex/hook.py\" enforce_citation_check.py",
            "timeout": 20
          },
          {
            "type": "command",
            "command": "python3 \"${PLUGIN_ROOT}/codex/hook.py\" enforce_prediction.py",
            "timeout": 15
          },
          {
            "type": "command",
            "command": "python3 \"${PLUGIN_ROOT}/codex/hook.py\" guard_experiment_exec.py",
            "timeout": 15
          },
          {
            "type": "command",
            "command": "python3 \"${PLUGIN_ROOT}/codex/hook.py\" enforce_decision_log.py",
            "timeout": 15
          },
          {
            "type": "command",
            "command": "python3 \"${PLUGIN_ROOT}/codex/hook.py\" guard_attack_files.py",
            "timeout": 15
          }
        ]
      },
      {
        "matcher": "Write|Edit|apply_patch",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${PLUGIN_ROOT}/codex/hook.py\" guard_attack_files.py",
            "timeout": 15
          },
          {
            "type": "command",
            "command": "python3 \"${PLUGIN_ROOT}/codex/hook.py\" enforce_unit_flow.py",
            "timeout": 15
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|apply_patch",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${PLUGIN_ROOT}/codex/hook.py\" check_references_edit.py",
            "timeout": 15
          }
        ]
      },
      {
        "matcher": "Write|apply_patch",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${PLUGIN_ROOT}/codex/hook.py\" record_paper_authorship.py",
            "timeout": 15
          }
        ]
      },
      {
        "matcher": "Write|Edit|Bash|apply_patch",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${PLUGIN_ROOT}/codex/hook.py\" record_attack_activity.py",
            "timeout": 15
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${PLUGIN_ROOT}/codex/session_start.py\"",
            "timeout": 10
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${PLUGIN_ROOT}/codex/hook.py\" resume_attack.py",
            "timeout": 30
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${PLUGIN_ROOT}/codex/hook.py\" continue_autopilot.py",
            "timeout": 30
          },
          {
            "type": "command",
            "command": "python3 \"${PLUGIN_ROOT}/codex/hook.py\" continue_attack.py",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
